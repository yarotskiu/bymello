{{ 'section-before-after.css' | asset_url | stylesheet_tag }}
{{ 'component-before-after-product.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
		--img-height: {{ section.settings.image_height }}%;
		--img-height-mb: {{ section.settings.image_height_mb }}%;
		{% if section.settings.use_custom_bg == true %}
			--product-bg-color: {{ section.settings.product_bg_color.red }},{{ section.settings.product_bg_color.green }},{{ section.settings.product_bg_color.blue }};
		{% endif %}
		{% if section.settings.before_label_color != blank %}
			--before-label-color: {{ section.settings.before_label_color }};
		{% endif %}	
		{% if section.settings.after_label_color != blank %}
			--after-label-color: {{ section.settings.after_label_color }};
		{% endif %}
	}
{%- endstyle -%}

<div class="before-after section-responsive-padding color-{{ section.settings.color_scheme }}">
	{%- if section.settings.heading != blank or section.settings.text != blank -%}
		<div class="page-width">
			<div class="title-wrapper {{ section.settings.heading_align }}">
				{%- if section.settings.heading != blank -%}
					<h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_font_family }} clr-text-{{ section.settings.heading_color }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
						{{ section.settings.heading }}
					</h2>
				{%- endif -%}

				{%- if section.settings.text != blank -%}
					<div class="description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
						{{ section.settings.text -}}
					</div>
				{%- endif -%}
			</div>
		</div>
	{%- endif -%}

	<div class="image-comparison__content {% if section.settings.full_width == false%} page-width {% endif %} isolate">
		<div class="image-comparison {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-id="{{ section.id }}" data-is-init="false" data-component="image-comparison-slider">
			{% if section.settings.icon != blank %}
				{% liquid
					assign classes = 'block-image-overlay block-image-overlay-1'
				%}

				{%- assign widths = '198, 230' -%}

				{%- capture sizes -%}
					(min-width: {{ settings.page_width }}px) 100vw,
					(min-width: 750px) calc(100vw - 130px), calc(100vw - 50px)
				{%- endcapture -%}

				{{
					section.settings.icon
					| image_url: width: 230
					| image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: classes, alt: 'background shape'
				}}
			{% endif %}
			{% if section.settings.icon_2 != blank %}
				{% liquid
					assign classes = 'block-image-overlay block-image-overlay-2'
				%}

				{%- assign widths = '198, 230' -%}

				{%- capture sizes -%}
					(min-width: {{ settings.page_width }}px) 100vw,
					(min-width: 750px) calc(100vw - 130px), calc(100vw - 50px)
				{%- endcapture -%}

				{{
					section.settings.icon_2
					| image_url: width: 230
					| image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: classes, alt: 'background shape'
				}}
			{% endif %}
			<image-comparison class="image-comparison {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-id="{{ section.id }}" data-is-init="false" data-layout="horizontal" data-component="image-comparison-slider">

				<div class="image-comparison__slider-wrapper">
					<label for="image-compare-range" class="image-comparison__label">Move image comparison slider</label>

					<input type="range" min="0" max="100" value="50" class="image-comparison__range" id="image-compare-range">
			
					<div class="image-comparison__image-wrapper image--before image-comparison__image-wrapper--overlay" style="clip-path: inset(0px 50% 0px 0px);">
						<figure class="image-comparison__figure image-comparison__figure--overlay">
							<div class="image-comparison__picture">

								{% if section.settings.before_image_label != blank %}
										<span class="image-comparison__label-text image-comparison__label-text--before {{ section.settings.before_label_size }} {{ section.settings.before_label_weight }}">
											{{ section.settings.before_image_label }}
										</span>
									
								{% endif %}

								{% 
									liquid
									assign is_image = false
									if section.settings.before_image != blank or section.settings.before_image_mb != blank
										assign is_image = true
									endif
								%}

								{%- if is_image -%}
									{%- if section.settings.before_image != blank -%}
										{% 
											liquid
											assign widths = '165, 360, 535, 750, 1070, 1200, 1920'
											assign class = "image-comparison__image"
											if section.settings.before_image_mb != blank
												assign class = class | append: ' small-hide'
											endif
										%}
										{%- capture sizes -%}
											(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px,
											(min-width: 750px) calc((100vw - 130px)), calc((100vw - 50px))
										{%- endcapture -%}
										{{
											section.settings.before_image
											| image_url: width: 1920
											| image_tag: loading: 'lazy',
											sizes: sizes,
											widths: widths,
											class: class,
											alt: section.settings.before_image.alt
										}}
									{%- endif -%}
									{%- if section.settings.before_image_mb != blank -%}
										{% 
											liquid
											assign widths = '165, 360, 535, 750, 1070, 1200, 1920'
											assign class = "image-comparison__image medium-hide large-up-hide"
										%}
										{%- capture sizes -%}
											(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px,
											(min-width: 750px) 100vw, 100vw 
										{%- endcapture -%}
										{{
											section.settings.before_image_mb
											| image_url: width: 1920
											| image_tag: loading: 'lazy',
											sizes: sizes,
											widths: widths,
											class: class,
											alt: section.settings.before_image_mb.alt
										}}
									{%- endif -%}
								{%- else -%}
									<div class="image-comparison__image image-comparison__default"></div>
								{%- endif -%} 
							</div>
							{%- if section.settings.before_product != blank -%}
								{% render 'before-after-product', color_scheme: section.settings.product_color_scheme, card_product: section.settings.before_product, position: 'before', image_ratio: section.settings.product_image_ratio, product_title: section.settings.before_product_title, show_type: section.settings.before_show_type, product_url: section.settings.before_product_url %}
							{%- endif -%}
						</figure>
					</div>
			
					<div class="image-comparison__image-wrapper image--after" style="clip-path: inset(0px 0px 0px 50%);">
						<figure class="image-comparison__figure">
							<div class="image-comparison__picture">

								{% if section.settings.after_image_label != blank %}
									<span class="image-comparison__label-text image-comparison__label-text--after {{ section.settings.after_label_size }} {{ section.settings.after_label_weight }}">
										{{ section.settings.after_image_label }}
									</span>
								{% endif %}

								{% 
									liquid
									assign is_image = false
									if section.settings.after_image != blank or section.settings.after_image_mb != blank
										assign is_image = true
									endif
								%}

								{%- if is_image -%}
									{%- if section.settings.after_image != blank -%}
										{% 
											liquid
											assign widths = '165, 360, 535, 750, 1070, 1200, 1920'
											assign class = "image-comparison__image"
											if section.settings.after_image_mb != blank
												assign class = class | append: ' small-hide'
											endif
										%}
										{%- capture sizes -%}
											(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px,
											(min-width: 750px) 100vw, 100vw
										{%- endcapture -%}
										{{
											section.settings.after_image
											| image_url: width: 1920
											| image_tag: loading: 'lazy',
											sizes: sizes,
											widths: widths,
											class: class,
											alt: section.settings.after_image.alt
										}}
									{%- endif -%}
									{%- if section.settings.after_image_mb != blank -%}
										{% 
											liquid
											assign widths = '165, 360, 535, 750, 1070, 1200, 1920'
											assign class = "image-comparison__image medium-hide large-up-hide"
										%}
										{%- capture sizes -%}
											(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px,
											(min-width: 750px) 100vw, 100vw
										{%- endcapture -%}
										{{
											section.settings.after_image_mb
											| image_url: width: 1920
											| image_tag: loading: 'lazy',
											sizes: sizes,
											widths: widths,
											class: class,
											alt: section.settings.after_image_mb.alt
										}}
									{%- endif -%}
								{%- else -%}
									<div class="image-comparison__image image-comparison__default"></div>
								{%- endif -%} 
							</div>
			
							{%- if section.settings.after_product != blank -%}
								{% render 'before-after-product', color_scheme: section.settings.product_color_scheme, card_product: section.settings.after_product, position: 'after', image_ratio: section.settings.product_image_ratio, product_title: section.settings.after_product_title, show_type: section.settings.after_show_type, product_url: section.settings.after_product_url %}
							{%- endif -%}
						</figure>
					</div>

					<div class="image-comparison__slider" style="--percent: 50%;">
						<div class="image-comparison__slider-shape image-comparison__slider-shape--top-left"></div>
						<div class="image-comparison__slider-shape image-comparison__slider-shape--top-right"></div>
						<span class="image-comparison__thumb" data-image-comparison-thumb="">
							{% render 'icon-toggle' %}
						</span>
						<div class="image-comparison__slider-shape image-comparison__slider-shape--bottom-left"></div>
						<div class="image-comparison__slider-shape image-comparison__slider-shape--bottom-right"></div>
					</div>
				</div>
			</image-comparison>
		</div>
	</div>
</div>

<script src="{{ 'before-after.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Before and after",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.additions"
    ],
		"templates": ["password"]
  },
  "settings": [
		{
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-2"
    },
		{
			"type": "checkbox",
			"id": "full_width",
			"label": "Full width",
			"default": false
		},
    {
      "type": "range",
      "id": "image_height",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "%",
      "label": "Image height",
      "default": 55
    },
    {
      "type": "range",
      "id": "image_height_mb",
      "min": 60,
      "max": 160,
      "step": 1,
      "unit": "%",
      "label": "Image height mobile",
      "default": 60
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Before and after",
      "label": "Heading"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
		{
			"type": "select",
			"id": "heading_color",
			"options": [
				{
					"value": "foreground",
					"label": "Text"
				},
				{
					"value": "foreground-secondary",
					"label": "Text secondary"
				},
				{
					"value": "heading",
					"label": "Heading"
				}
			],
			"default": "foreground",
			"label": "Heading color"
		},
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Explore a range of product variations to discover the ideal match that perfectly suits your style and needs.</p>",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Content align"
    },
    {
      "type": "header",
      "content": "\"Before\" settings"
    },
		{
			"type": "text",
			"id": "before_image_label",
			"label": "Label"
		},
		{
			"type": "color",
			"id": "before_label_color",
			"label": "Label color",
			"default": "#171717",
			"visible_if": "{{ section.settings.before_image_label != blank }}"
		},
		{
      "type": "select",
      "id": "before_label_size",
			"visible_if": "{{ section.settings.before_image_label != blank }}",
      "options": [
				{
          "value": "h5",
          "label": "Extra small"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Label size"
    },
		{
			"type": "select",
			"id": "before_label_weight",
			"visible_if": "{{ section.settings.before_image_label != blank }}",
			"options": [
				{
					"value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
				},
				{
					"value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
				},
				{
					"value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
				},
				{
					"value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
				}
			],
			"default": "fw-500",
			"label": "Label font weight"
		},
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Image",
      "info": "For best results, use an image with width and height like in an external image container."
    },
    {
      "type": "image_picker",
      "id": "before_image_mb",
      "label": "Image mobile"
    },
		{
			"type": "product",
			"id": "before_product",
			"label": "Product"
		},
		{
			"type": "text",
			"id": "before_product_title",
			"label": "Product title",
			"info": "Replaces default title"
		},
		{
			"type": "checkbox",
			"id": "before_show_type",
			"default": true,
			"label": "Show type"
		},
		{
			"type": "url",
			"id": "before_product_url",
			"label": "Product link",
			"info": "Use this to access a specific product variant"
		},
    {
      "type": "header",
      "content": "\"After\" settings"
    },
		{
			"type": "text",
			"id": "after_image_label",
			"label": "Label"
		},
		{
			"type": "color",
			"id": "after_label_color",
			"label": "Label color",
			"default": "#171717",
			"visible_if": "{{ section.settings.after_image_label != blank }}"
		},
		{
      "type": "select",
      "id": "after_label_size",
			"visible_if": "{{ section.settings.after_image_label != blank }}",
      "options": [
				{
          "value": "h5",
          "label": "Extra small"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Label size"
    },
		{
			"type": "select",
			"id": "after_label_weight",
			"visible_if": "{{ section.settings.after_image_label != blank }}",
			"options": [
				{
					"value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
				},
				{
					"value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
				},
				{
					"value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
				},
				{
					"value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
				}
			],
			"default": "fw-500",
			"label": "Label font weight"
		},
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Image",
      "info": "For best results, use an image with width and height like in an external image container."
    },
    {
      "type": "image_picker",
      "id": "after_image_mb",
      "label": "Image mobile"
    },
		{
			"type": "product",
			"id": "after_product",
			"label": "Product"
		},
		{
			"type": "text",
			"id": "after_product_title",
			"label": "Product title",
			"info": "Replaces default title"
		},
		{
			"type": "checkbox",
			"id": "after_show_type",
			"default": true,
			"label": "Show type"
		},
		{
			"type": "url",
			"id": "after_product_url",
			"label": "Product link",
			"info": "Use this to access a specific product variant"
		},
    {
      "type": "header",
      "content": "Product card"
    },
		{
      "type": "color_scheme",
      "id": "product_color_scheme",
      "label": "Product color scheme",
      "default": "scheme-1"
    },
		{
			"type": "checkbox",
			"id": "use_custom_bg",
			"default": false,
			"label": "Use custom background"
		},
		{
			"type": "color",
			"id": "product_bg_color",
			"label": "Product background color",
			"default": "#ffffff",
			"visible_if": "{{ section.settings.use_custom_bg == true }}"
		},
		{
			"type": "select",
			"id": "product_image_ratio",
			"options": [
				{
					"value": "portrait",
					"label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
				},
				{
					"value": "landscape",
					"label": "Landscape"
				}
			],
			"default": "square",
			"label": "t:sections.main-list-collections.settings.image_ratio.label"
		},
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ],
  "presets": [
    {
      "name": "Before and after"
    }
  ]
}
{% endschema %}
