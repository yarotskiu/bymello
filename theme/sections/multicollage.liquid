{{ 'section-multicollage.css' | asset_url | stylesheet_tag }}


{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
  }
{%- endstyle -%}

<div class="gradient isolate section-responsive-padding {% if section.settings.mobile_layout == 'collage' and section.blocks.size > 2 %} collage--mobile {% endif %} multicollage multicollage-{{ section.blocks.size }} color-{{ section.settings.color_scheme }}" >
  <div class="page-width">
    
		{%- if section.settings.heading != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_weight }} {{ section.settings.heading_font_family }} {{ section.settings.heading_font_family }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid-main grid-main--default {% if section.settings.mobile_layout == 'collage' and section.blocks.size > 2 %} col-sm-2 {% endif %}">
      {%- for block in section.blocks -%}
        <div class="collage__item collage__item--{{ block.type }} collage__item--{{ forloop.index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in {% endif %}" {{ block.shopify_attributes }} {% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>

          {%- case block.type -%}

            {%- when 'collection' -%}

              {%- if block.settings.collection != blank -%}
                <a href="{{ block.settings.collection.url }}" class="card-wrapper color-{{ block.settings.color_scheme }}">

                  {%- assign widths = '165, 360, 535, 750, 1070, 1200' -%}
									{%- assign featured_image = '' -%}
                  {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) {{ settings.page_width }}px,
                    (min-width: 750px) calc((100vw)), calc((100vw))
                  {%- endcapture -%}

									{% assign image_width = 1920 %}

                  {% if block.settings.collection.featured_image != blank or block.settings.image != blank %}
										{% liquid
											if block.settings.collection.featured_image != blank
												assign featured_image = block.settings.collection.featured_image
											endif		
											if block.settings.image != blank
												assign featured_image = block.settings.image
											endif		
										%}
                    {{
                      featured_image
                      | image_url: width: image_width
                      | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: featured_image.alt
                    }}
                  {% else %}
                    {%- assign placeholder_image = 'collection-' | append: forloop.rindex -%}
                    {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  {% endif %}

                  <div class="card-label card-label-{{ forloop.index }}">
                    <h3 class="h5 clr-text-{{ block.settings.heading_color }}">
                      {% if block.settings.custom_heading != blank %}
                        {{- block.settings.custom_heading | escape -}}
                      {% else %}
                        {{- block.settings.collection.title | escape -}}
                      {% endif %}
                    </h3>
										<button class="slider-button button--animate-{{ settings.animations_hover_elements }}" aria-label="{{- block.settings.collection.title | escape -}}" role="button">
											{% render 'icon-short-arrow' %}
										</button>
                  </div>
                </a>
              {%- else -%}
                <div class="card-wrapper card-empty">
                  {%- assign placeholder_image = 'collection-' | append: forloop.rindex -%}

                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg placeholder' }}

                  <div class="card-label card-label-{{ forloop.index }}">
                    <h3 class="h5 clr-text-{{ block.settings.heading_color }}">
                      {{ 'onboarding.collection_title' | t }}
                    </h3>
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicollage",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.additions"
    ],
		"templates": ["password"]
  },
  "settings": [
		{
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-2"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Collections collage",
      "label": "Heading"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
		{
			"type": "select",
			"id": "heading_weight",
			"options": [
				{
					"value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
				},
				{
					"value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
				},
				{
					"value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
				},
				{
					"value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
				}
			],
			"default": "fw-500",
			"label": "t:settings_schema.global.settings.text_weight.label"
		},
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        {
          "value": "collage",
          "label": "Collage"
        },
        {
          "value": "column",
          "label": "Column"
        }
      ],
      "default": "column",
      "label": "Mobile layout"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collage.blocks.collection.name",
      "settings": [
				{
					"type": "color_scheme",
					"id": "color_scheme",
					"label": "t:sections.all.colors.label",
					"default": "background-3"
				},
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collage.blocks.collection.settings.collection.label"
        },
				{
					"type": "image_picker",
					"id": "image",
					"label": "Custom image"
				},
        {
          "type": "text",
          "id": "custom_heading",
          "label": "Custom heading"
        },			
				{
					"type": "select",
					"id": "heading_color",
					"options": [
						{
							"value": "foreground",
							"label": "Text"
						},
						{
							"value": "foreground-secondary",
							"label": "Text secondary"
						},
						{
							"value": "heading",
							"label": "Heading"
						}
					],
					"default": "foreground",
					"label": "Heading color"
				}
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Multicollage",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
