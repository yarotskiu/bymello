{{ 'section-icon-with-text.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;

		--swiper-autoplay-delay: {{ section.settings.change_slides_speed }}s;
	}
{%- endstyle -%}

<icon-with-text class="icon-with-text section-responsive-padding color-{{ section.settings.color_scheme }} gradient" 
	data-enable-swiper-mb="true"
	data-slides-per-view="{{ section.settings.slides_per_view }}"
	data-slides-per-view-lg="{{ section.settings.columns_desktop }}"
	data-autoplay="{{ section.settings.auto_rotate }}"
	data-change-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
	data-speed="{{ section.settings.scroll_speed | times: 1000 }}"
	data-space-between="{{ settings.spacing_grid_horizontal_mb }}"
	data-slides-length="{{ section.blocks.size }}"
>
  <div
    class="isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="page-width title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_font_family }} {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
		<div class="color-{{ section.settings.container_color_scheme }}">
			<div class="icon-with-text__content-wrapper page-width {% if section.settings.container_color_scheme != section.settings.color_scheme %} icon-with-text__content-wrapper--container{% endif %}">
				<div class="swiper icon-with-text__swiper">
					<div
						class="icon-with-text__content icon-with-text__content--align-{{ section.settings.desktop_content_alignment }} contains-content-container grid  grid--{{ section.settings.columns_desktop }}-col-desktop swiper-wrapper"
					>
						{%- liquid
							assign highest_ratio = 0
							for block in section.blocks
								if block.settings.image.aspect_ratio > highest_ratio
									assign highest_ratio = block.settings.image.aspect_ratio
								endif
							endfor
						-%}
						{%- for block in section.blocks -%}
							{%- assign empty_column = '' -%}
							{%- if block.settings.image == blank
								and block.settings.title == blank
								and block.settings.text == blank
								and block.settings.link_label == blank
							-%}
								{%- assign empty_column = ' icon-with-text__item--empty' -%}
							{%- endif -%}
							
							<div
								id="Slide-{{ section.id }}-{{ forloop.index }}"
								class="icon-with-text__item grid__item  swiper-slide {{ empty_column }}"
								{{ block.shopify_attributes }}
								{% if settings.animations_reveal_on_scroll %}
									data-cascade
									style="--animation-order: {{ forloop.index }};"
								{% endif %}
							>
								<div class="icon-with-text__card">
										<div
											class="icon-with-text__image-wrapper"
										>

											{%- if block.settings.image != blank -%}
												<div
													class="icon-with-text__media media media--transparent media--{{ section.settings.image_ratio }}"
													{% if section.settings.image_ratio == 'adapt' %}
														style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
													{% endif %}
												>
													{%- liquid
														assign number_of_columns = section.settings.columns_desktop
														assign number_of_columns_mobile = 1
														assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
														assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
														assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
														assign image_width = 1
													-%}
													{% capture sizes %}
														(min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
														(min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
														(min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
														calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
													{% endcapture %}
													{{
														block.settings.image
														| image_url: width: 3200
														| image_tag:
															widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
															alt: block.settings.image.alt,
															sizes: sizes,
															class: 'icon-with-text__image'
													}}
												</div>
											{%- endif -%}
										</div>
									<div class="icon-with-text__info">
										{%- if block.settings.title != blank -%}
											<h3 class="icon-with-text__title inline-richtext clr-text-{{ block.settings.heading_color }} {{ block.settings.heading_font_family }} {{ block.settings.title_size }} {{ block.settings.title_weight }}">{{ block.settings.title }}</h3>
										{%- endif -%}
										{%- if block.settings.text != blank -%}
											<div class="description rte clr-text-{{ block.settings.text_color }}">{{ block.settings.text }}</div>
										{%- endif -%}
									</div>
								</div>
							</div>
						{%- endfor -%}
					</div>	
				</div>
			</div>
		</div>
		<div class="icon-with-text__swiper-controls swiper-controls large-up-hide">
			<div class="swiper-pagination icon-with-text__swiper-pagination"></div>
		</div>
  </div>
</icon-with-text>

<script src="{{ 'icon-with-text.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.icon_with_text.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"],
		"templates": ["password"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.icon_with_text.settings.title.label"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.icon_with_text.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.icon_with_text.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.icon_with_text.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.icon_with_text.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.icon_with_text.settings.columns_desktop.label"
    },
		{
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "container_color_scheme",
      "label": "t:sections.icon_with_text.settings.container_color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.icon_with_text.settings.header_mobile.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.icon_with_text.settings.auto_rotate.label",
      "default": true
    },
		{
			"type": "range",
			"id": "slides_per_view",
			"min": 1,
			"max": 2,
			"step": 0.1,
			"label": "Slides per view",
			"default": 1
		},
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 5,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.icon_with_text.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 0.3,
      "max": 4.5,
      "step": 0.1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.scroll_speed.label",
      "default": 1.7
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 24
    },
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.icon_with_text.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.icon_with_text.blocks.column.settings.image.label"
        },	
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Column",
          "label": "t:sections.icon_with_text.blocks.column.settings.title.label"
        },
				{
					"type": "select",
					"id": "heading_font_family",
					"label": "Heading font family",
					"options": [
						{
						"value": "font-heading",
						"label": "Heading"
						},
						{
						"value": "font-body",
						"label": "Body"
						}
					],
					"default": "font-heading"
				},
				{
          "type": "select",
          "id": "heading_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground",
          "label": "Heading color"
        },
        {
          "type": "select",
          "id": "title_size",
          "options": [
            {
              "value": "h6",
              "label": "Extra small"
            },
            {
              "value": "h5",
              "label": "Small"
            },
            {
              "value": "h4",
              "label": "Medium"
            },
            {
              "value": "h3",
              "label": "Large"
            }
          ],
          "default": "h6",
          "label": "Heading size"
        },
				{
					"type": "select",
					"id": "title_weight",
					"options": [
						{
							"value": "fw-400",
							"label": "t:settings_schema.global.settings.text_weight.options__1.label"
						},
						{
							"value": "fw-500",
							"label": "t:settings_schema.global.settings.text_weight.options__2.label"
						},
						{
							"value": "fw-600",
							"label": "t:settings_schema.global.settings.text_weight.options__3.label"
						},
						{
							"value": "fw-700",
							"label": "t:settings_schema.global.settings.text_weight.options__4.label"
						}
					],
					"default": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.label"
				},
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.icon_with_text.blocks.column.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground-secondary",
          "label": "Text color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.icon_with_text.presets.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
