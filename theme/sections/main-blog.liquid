      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Banner color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "banner_height",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "default",
      "label": "Banner height"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Custom title"
    },
    {
      "type": "select",
      "id": "title_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "title_weight",
      "options": [
        {
          "value": "fw-400",
          "label": "t:settings_schema.global.settings.text_weight.options__1.label"
        },
        {
          "value": "fw-500",
          "label": "t:settings_schema.global.settings.text_weight.options__2.label"
        },
        {
          "value": "fw-600",
          "label": "t:settings_schema.global.settings.text_weight.options__3.label"
        },
        {
          "value": "fw-700",
          "label": "t:settings_schema.global.settings.text_weight.options__4.label"
        }
      ],
      "default": "fw-600",
      "label": "t:settings_schema.global.settings.text_weight.label"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "default": "Read the last updates and news about our brand and line of products.",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "banner_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 70
