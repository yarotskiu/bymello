      "label": "t:sections.all.padding.padding_bottom",
      "default": 70
    },
    {
      "type": "range",
      "id": "banner_padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "banner_padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
    {
      "type": "header",
      "content": "Tags"
    },
    {
      "type": "select",
      "id": "tags_style",
