{{ 'section-countdown-banner.css' | asset_url | stylesheet_tag }}


{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
  }

  {% unless section.settings.full_width %}
	#shopify-section-{{ section.id }} .countdown-banner {
		--padding-top: {{ section.settings.padding_top_background }}px;
		--padding-bottom: {{ section.settings.padding_bottom_background }}px;
		--padding-top-mb: {{ section.settings.padding_top_background_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_background_mb }}px;
	}
  {% endunless %}

  {% if section.settings.desktop_background_image != blank %}
  #shopify-section-{{ section.id }} .countdown-banner {
    background-image: url('{{ section.settings.desktop_background_image | image_url }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  {% endif %}
  {% if section.settings.mobile_background_image != blank %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .countdown-banner {
      background-image: url('{{ section.settings.mobile_background_image | image_url: width: 750 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  }
  {% endif %}
{%- endstyle -%}

{% unless section.settings.full_width %}<div class="countdown-banner-notfull-width page-width color-{{ section.settings.color_scheme_background }} section-responsive-padding">{% endunless %}
<div class="countdown-banner section-responsive-padding color-{{ section.settings.color_scheme }} {% unless section.settings.full_width %}content-container{% endunless %}">
  <div class="page-width">
    <div class="countdown-banner__wrapper">
			{%- if section.settings.heading != blank -%}
				<div class="countdown-banner__title-wrapper">
					<h2 class="title countdown-banner__title inline-richtext {{ section.settings.heading_font_family }} {{ section.settings.heading_size }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text{% endif %} clr-text-{{ section.settings.text_color }}">
						{{ section.settings.heading }}
					</h2>

					{%- if section.settings.text != blank -%}
						<p class="description countdown-banner__description inline-richtext {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %} clr-text-{{ section.settings.text_color }}">
							{{ section.settings.text -}}
						</p>
					{%- endif -%}
				</div>

			{%- endif -%}
      <div class="countdown-banner__countdown">

				<countdown-bar id="countdownBar-{{ section.id }}" class="countdown-banner__countdown-bar {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-date="{{ section.settings.countdown_date }}" data-complited="{{ section.settings.countdown_end }}">
					<div class="countdown-banner__countdown-items">
						<div class="countdown-banner__countdown-item countdown-bar__days">
							<span class="countdown-banner__countdown-number countdown-bar__number h3 clr-text-{{ section.settings.text_color }}">
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
							</span>
							<span class="countdown-banner__countdown-title countdown-bar__title clr-text-{{ section.settings.text_color }}">
								{{- section.settings.days_label -}}
							</span>
						</div>
					
						<div class="countdown-banner__countdown-item countdown-bar__hours">
							<span class="countdown-banner__countdown-number countdown-bar__number h3 clr-text-{{ section.settings.text_color }}">
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
							</span>
							<span class="countdown-banner__countdown-title countdown-bar__title clr-text-{{ section.settings.text_color }}">
								{{- section.settings.hours_label -}}
							</span>
						</div>
					
						<div class="countdown-banner__countdown-item countdown-bar__min">
							<span class="countdown-banner__countdown-number countdown-bar__number h3 clr-text-{{ section.settings.text_color }}">
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
							</span>
							<span class="countdown-banner__countdown-title countdown-bar__title clr-text-{{ section.settings.text_color }}">
								{{- section.settings.mins_label -}}
							</span>
						</div>
					
						<div class="countdown-banner__countdown-item countdown-bar__sec">
							<span class="countdown-banner__countdown-number countdown-bar__number h3 clr-text-{{ section.settings.text_color }}">
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
								<countdown-digit class="countdown-bar__digit" number="0">0</countdown-digit>
							</span>
							<span class="countdown-banner__countdown-title countdown-bar__title clr-text-{{ section.settings.text_color }}">
								{{- section.settings.secs_label -}}
							</span>
						</div>
					</div>
				</countdown-bar>
      </div>
    </div>
  </div>
</div>

{% unless section.settings.full_width %}</div>{% endunless %}

<script src="{{ 'countdown.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "Countdown banner",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Countdown banner",
      "label": "Heading"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
		{
			"type": "select",
			"id": "text_color",
			"options": [
				{
					"value": "foreground",
					"label": "Text"
				},
				{
					"value": "foreground-secondary",
					"label": "Text secondary"
				},
				{
					"value": "heading",
					"label": "Heading"
				}
			],
			"default": "foreground",
			"label": "Content color"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "default": "Explore a range of product variations to discover the ideal match that perfectly suits your style and needs.",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full width"
    },
		{
      "type": "color_scheme",
      "id": "color_scheme_background",
      "label": "Section color scheme",
			"visible_if": "{{ section.settings.full_width == false }}",
      "default": "scheme-2"
    },
		{
      "type": "header",
      "content": "Not full width content padding",
			"visible_if": "{{ section.settings.full_width == false }}"
    },
	
    {
      "type": "range",
      "id": "padding_top_background",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
			"visible_if": "{{ section.settings.full_width == false }}",
      "default": 40
    },	
    {
      "type": "range",
      "id": "padding_bottom_background",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
			"visible_if": "{{ section.settings.full_width == false }}",
      "default": 40
    },
		{
      "type": "range",
      "id": "padding_top_background_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top padding mobile",
			"visible_if": "{{ section.settings.full_width == false }}",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_background_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding mobile",
			"visible_if": "{{ section.settings.full_width == false }}",
      "default": 40
    },
		{
      "type": "header",
      "content": "Content background"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
		{
      "type": "header",
      "content": "Countdown settings"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "default": "July 01, 2024",
      "label": "End date",
      "info": "Example: Dec 31, 2023 or Dec 31, 2023 20:00"
    },
		{
			"type": "select",
			"id": "countdown_end",
			"options": [
				{
					"value": "show_zeroes",
					"label": "Show zeroes"
				},
				{
					"value": "hide_countdown",
					"label": "Hide countdown"
				},
				{
					"value": "cycle",
					"label": "Cycle"
				}
			],
			"default": "cycle",
			"label": "When date has passed"
		},
		{
			"type": "text",
			"id": "days_label",
			"default": "Days",
			"label": "Days"
		},
		{
			"type": "text",
			"id": "hours_label",
			"default": "Hours",
			"label": "Hours"
		},
		{
			"type": "text",
			"id": "mins_label",
			"default": "Minutes",
			"label": "Minutes"
		},
		{
			"type": "text",
			"id": "secs_label",
			"default": "Seconds",
			"label": "Seconds"
		},
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
