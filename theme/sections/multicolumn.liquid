{{ 'section-multicolumn.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'component-slider.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .multicolumn {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;

		--title-width: {{ section.settings.heading_width }}px;

		{% if section.settings.enable_min_height %} 
			--min-height: {{ section.settings.columns_min_height }}%;
		{% endif %}
	}
{%- endstyle -%}

<div class="multicolumn section-responsive-padding color-{{ section.settings.color_scheme }} gradient background-{{ section.settings.background_style }}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper title-wrapper--self-padded-mobile title-wrapper--no-top-margin alignment-{{ section.settings.column_alignment }} alignment-mobile-{{ section.settings.column_alignment_mobile }}">
        <h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_weight }} {{ section.settings.heading_font_family }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text{% endif %}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}{% if section.settings.enable_min_height %} min-height{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}
					
						{%- style -%}
							#Slide-{{ section.id }}-{{ forloop.index }} {
								{%- if block.settings.heading_gradient != blank -%}
									--text-gradient: {{ block.settings.heading_gradient }};
								{%- endif -%}

								{%- if block.settings.column_image_background != blank -%}
									--bg-image: url('{{ block.settings.column_image_background | image_url: width: block.settings.column_image_background.width }}');
								{%- endif -%}

								{%- if block.settings.overlay != blank -%}
									--overlay: {{ block.settings.overlay }};
								{%- endif -%}
								--overlay-opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
							}
						{%- endstyle -%}


          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item {% if block.settings.column_image_background != blank %} img-on-bg {% endif %} {% if section.settings.swipe_on_mobile %} slider__slide{% endif %} content-align-{{ section.settings.column_alignment }} content-align-mobile-{{ section.settings.column_alignment_mobile }} vertical-alignment-{{ section.settings.vertical_content_alignment }} {{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} {%if block.settings.show_borders == 'borders'%} borders {% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container color-{{ section.settings.column_color_scheme }}">
							<div>
								{%- if block.settings.image != blank -%}
									{% if section.settings.image_ratio == 'adapt' %}
										{% assign spaced_image = true %}
									{% endif %}
									<div
										class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}"
										{% if section.settings.image_width == 'custom' %}
											style="--_max-width: {{ section.settings.custom_image_width }}px;"
										{% endif %}
									>
                     {% if block.settings.image != blank and block.settings.link != blank and block.settings.make_image_clickable %}
                      <a 
                        href="{{ block.settings.link }}" class="media media--transparent media--{{ section.settings.image_ratio }} multicolumn-card__image-link"
                        {% if section.settings.image_ratio == 'adapt' %}
                          style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                        {% endif %}
                      >
                      {%else%}
                        <div
                          class="media media--transparent media--{{ section.settings.image_ratio }}"
                          {% if section.settings.image_ratio == 'adapt' %}
                            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                          {% endif %}
                        >
                    {% endif %}
										
											{%- liquid
												assign number_of_columns = section.settings.columns_desktop
												assign number_of_columns_mobile = section.settings.columns_mobile
												assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
												assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
												assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
												if section.settings.image_width == 'half'
													assign image_width = 0.5
												elsif section.settings.image_width == 'third'
													assign image_width = 0.33
												else
													assign image_width = 1
												endif
											-%}
											{% capture sizes %}
												(min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
												(min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
												(min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
												calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
											{% endcapture %}
											{{
												block.settings.image
												| image_url: width: 3200
												| image_tag:
													widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
													alt: block.settings.image.alt,
													sizes: sizes,
													class: 'multicolumn-card__image'
											}}
                    {% if block.settings.image != blank and block.settings.link != blank and block.settings.make_image_clickable %}
                      </a>
                    {% else %}
                      </div>
                    {% endif %}
									</div>
								{%- endif -%}
								<div class="multicolumn-card__info">
									{%- if block.settings.title != blank -%}
										<h3 class="inline-richtext clr-text-{{ block.settings.heading_color }} {% if block.settings.heading_gradient != blank %} text-gradient {% endif %} {{ block.settings.title_size }} {{ block.settings.title_weight }}">{{ block.settings.title }}</h3>
									{%- endif -%}
									{%- if block.settings.subheading != blank -%}
										<div class="subheading rte">{{ block.settings.subheading }}</div>
									{%- endif -%}
									{%- if block.settings.text != blank -%}
										<div class="description rte clr-text-{{ block.settings.text_color }}">{{ block.settings.text }}</div>
									{%- endif -%}
									{%- if block.settings.link_label != blank -%}
										<a class="link link-with-underline" 
											{% if block.settings.link == blank %}
												role="link" aria-disabled="true"
											{% else %}
												href="{{ block.settings.link }}"
											{% endif %}
										>
											{{- block.settings.link_label | escape -}}
										</a>
									{%- endif -%}
								</div>
							</div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons no-js-hidden large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev button--animate-{{ settings.animations_hover_elements }}"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
						{% render 'icon-short-arrow' %}		
          </button>
          <button
            type="button"
            class="slider-button slider-button--next button--animate-{{ settings.animations_hover_elements }}"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
						{% render 'icon-short-arrow' %}		
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
					{{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Multicolumn",
      "label": "t:sections.multicolumn.settings.title.label"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__3.label"
				}
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
		{
			"type": "select",
			"id": "heading_weight",
			"options": [
				{
					"value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
				},
				{
					"value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
				},
				{
					"value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
				},
				{
					"value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
				}
			],
			"default": "fw-500",
			"label": "t:settings_schema.global.settings.text_weight.label"
		},
		{
			"type": "range",
			"id": "heading_width",
			"min": 200,
			"max": 1000,
			"step": 10,
			"unit": "px",
			"label": "Heading width",
			"default": 530
		},
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "Primary"
				},
				{
					"value": "secondary",
					"label": "Secondary"
				}
			],
			"default": "primary",
			"label": "t:sections.multirow.settings.button_style.label"
		},
		{
			"type": "select",
			"id": "button_outline",
			"label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label",
			"options": [
				{
				"value": "outline-none",
				"label": "None"
				},
				{
				"value": "outline",
				"label": "Outline"
				},
				{
				"value": "outline-hover",
				"label": "Outline on hover"
				},
			],
			"default": "outline-hover"
		},
    {
      "type": "header",
      "content": "Column settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "range",
      "id": "custom_image_width",
      "min": 20,
      "max": 500,
      "step": 5,
      "unit": "px",
      "label": "Custom image width",
      "default": 30
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "enable_min_height",
      "label": "Enable min height",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_min_height",
      "min": 20,
      "max": 120,
      "unit": "%",
      "step": 1,
      "default": 100,
      "label": "Columns min height"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "vertical_content_alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "label": "Vertical content alignment"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "Show column background"
        }
      ],
      "default": "none",
      "label": "t:sections.multicolumn.settings.background_style.label",
			"info": "Column background image replaces color"
    },
    {
      "type": "color_scheme",
      "id": "column_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "select",
      "id": "column_alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },	
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Column",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
				{
          "type": "select",
          "id": "heading_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground",
          "label": "Heading color"
        },
				{
					"type": "color_background",
					"id": "heading_gradient",
					"label": "Heading gradient",
					"info": "Replaces color"
				},
        {
          "type": "select",
          "id": "title_size",
          "options": [
            {
              "value": "h5",
              "label": "Extra small"
            },
            {
              "value": "h4",
              "label": "Small"
            },
            {
              "value": "h3",
              "label": "Medium"
            },
            {
              "value": "h2",
              "label": "Large"
            },
            {
              "value": "h1",
              "label": "Extra large"
            }
          ],
          "default": "h3",
          "label": "Heading size"
        },
				{
					"type": "select",
					"id": "title_weight",
					"options": [
						{
							"value": "fw-400",
							"label": "t:settings_schema.global.settings.text_weight.options__1.label"
						},
						{
							"value": "fw-500",
							"label": "t:settings_schema.global.settings.text_weight.options__2.label"
						},
						{
							"value": "fw-600",
							"label": "t:settings_schema.global.settings.text_weight.options__3.label"
						},
						{
							"value": "fw-700",
							"label": "t:settings_schema.global.settings.text_weight.options__4.label"
						}
					],
					"default": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.label"
				},
				{
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground-secondary",
          "label": "Text color"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
