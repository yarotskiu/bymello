<button
	id="cart-icon-bubble-sticky"
	class="cart-icon-bubble-sticky link cart-modal focus-inset {% if template == 'cart' %} hidden {% endif %}"
	type="button"
	name="{{ 'templates.cart.cart' | t }}"
	aria-label="{{ 'templates.cart.cart' | t }}"
>
	<span class="bm-sticky-icon">
		{% render 'icon-nav-bag' %}
		{%- if cart != empty -%}
			<div class="cart-count-bubble cart-count-bubble-sticky">
				{%- if cart.item_count <= 100 -%}
					<span aria-hidden="true">{{ cart.item_count }}</span>
				{%- endif -%}
				<span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
			</div>
		{%- endif -%}
	</span>
</button>