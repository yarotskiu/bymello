{% if section.blocks.size > 0 %}
  {{ 'section-mobile-sticky-bar.css' | asset_url | stylesheet_tag }}

  {% style %}
		#shopify-section-{{ section.id }} {
			--counter-foreground: {{ section.settings.counter_color }};
			--counter-bg: {{ section.settings.counter_bg }};
		}

    @media screen and (max-width:989px) {
      #shopify-section-footer {
        padding-bottom: 5.5rem;
      }
      .menu-drawer .list-social {
        margin-top: 0;
        margin-bottom: 4rem;
      }
      {% if request.design_mode and section.settings.enable_in_customizer %}
        div.mobile-sticky-bar {
          transform: translateY(0);
        }
      {% endif %}
    }
  {% endstyle %}

  <div class="color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <ul class="grid grid--col{% if section.blocks.size > 0 %} grid--{{ section.blocks.size }}-col{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'home' -%}
              <li class="grid__item" {{ block.shopify_attributes }}>
                <a
                  class="link"
                  href="{{ routes.root_url }}"
                  title="{{ shop.name | replace: '-', ' ' | capitalize }}"
                  aria-label="{{ shop.name | replace: '-', ' ' | capitalize }}"
                >
                  {% render 'icon-nav-home' %}
                </a>
              </li>

            {%- when 'collection' -%}
              <li class="grid__item" {{ block.shopify_attributes }}>
                <a class="link" href="{{ routes.all_products_collection_url }}" title="Products" aria-label="Products">
                  {% render 'icon-nav-store' %}
                </a>
              </li>

            {%- when 'cart' -%}
							<li class="grid__item {% if template == 'cart' %} hidden {% endif %}" {{ block.shopify_attributes }}>
								{% if settings.cart_type == 'drawer' %}
									<button
										id="cart-icon-bubble-sticky"
										class="cart-icon-bubble-sticky link cart-modal"
										type="button"
										name="{{ 'templates.cart.cart' | t }}"
										aria-label="{{ 'templates.cart.cart' | t }}"
									>
										<span class="bm-sticky-icon">
											{% render 'icon-nav-bag' %}
											{%- if cart != empty -%}
												<div class="cart-count-bubble cart-count-bubble-sticky">
													{%- if cart.item_count <= 100 -%}
														<span aria-hidden="true">{{ cart.item_count }}</span>
													{%- endif -%}
													<span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
												</div>
											{%- endif -%}
										</span>
									</button>
								{% else %}
									<a href="{{ routes.cart_url }}" id="cart-icon-bubble-sticky" class="cart-icon-bubble-sticky link cart-modal">
										<span class="bm-sticky-icon">
											{% render 'icon-nav-bag' %}
											{%- if cart != empty -%}
												<div class="cart-count-bubble cart-count-bubble-sticky">
													{%- if cart.item_count <= 100 -%}
														<span aria-hidden="true">{{ cart.item_count }}</span>
													{%- endif -%}
													<span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
												</div>
											{%- endif -%}
										</span>
									</a>
								{% endif %}
							</li>

            {%- when 'wishlist' -%}
              <li class="grid__item" {{ block.shopify_attributes }}>
                <a href="/pages/wishlist" class="link header__icon--wishlist" aria-label="Wishlist">
                  <span class="bm-sticky-icon">
                    {% render 'icon-nav-heart' %}
                    <div class="cart-count-bubble" data-wishlist-count></div>
                  </span>
                </a>
              </li>

            {%- when 'search' -%}
              <li class="grid__item" {{ block.shopify_attributes }}>
                <details-modal class="header__search">
                  <details>
                    <summary
                      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
                      aria-haspopup="dialog"
                      aria-label="{{ 'general.search.search' | t }}"
                    >
                      <span class="link">
												<svg class="icon icon-scroll" width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M23.748 23.8802L27.8 27.8002M26.4933 17.3469C26.4933 22.3984 22.3982 26.4935 17.3466 26.4935C12.2951 26.4935 8.19995 22.3984 8.19995 17.3469C8.19995 12.2953 12.2951 8.2002 17.3466 8.2002C22.3982 8.2002 26.4933 12.2953 26.4933 17.3469Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
												</svg>
																								
                      </span>
                    </summary>

                    <div
                      class="search-modal modal__content gradient"
                      role="dialog"
                      aria-modal="true"
                      aria-label="{{ 'general.search.search' | t }}"
                    >
                      <div class="modal-overlay"></div>
                      <div
                        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
                        tabindex="-1"
                      >
                        {%- if settings.predictive_search_enabled -%}
                          <predictive-search
                            class="search-modal__form"
                            data-loading-text="{{ 'accessibility.loading' | t }}"
                          >
                        {%- else -%}
                          <search-form class="search-modal__form">
                        {%- endif -%}
                        <form
                          action="{{ routes.search_url }}"
                          method="get"
                          role="search"
                          class="search search-modal__form"
                        >
                          <div class="field">
                            <input
                              class="search__input field__input"
                              id="Search-In-Modal-sticky"
                              type="search"
                              name="q"
                              value="{{ search.terms | escape }}"
                              placeholder="{{ 'general.search.search' | t }}"
                              {%- if settings.predictive_search_enabled -%}
                                role="combobox"
                                aria-expanded="false"
                                aria-owns="predictive-search-results"
                                aria-controls="predictive-search-results"
                                aria-haspopup="listbox"
                                aria-autocomplete="list"
                                autocorrect="off"
                                autocomplete="off"
                                autocapitalize="off"
                                spellcheck="false"
                              {%- endif -%}
                            >
                            <label class="field__label" for="Search-In-Modal-sticky">
                              {{- 'general.search.search' | t -}}
                            </label>
                            <input type="hidden" name="options[prefix]" value="last">
                            <button
                              type="reset"
                              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                              aria-label="{{ 'general.search.reset' | t }}"
                            >
                              <svg class="icon icon-close" aria-hidden="true" focusable="false">
                                <use xlink:href="#icon-reset">
                              </svg>
                            </button>
                            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                              <svg class="icon icon-search" aria-hidden="true" focusable="false">
                                <use href="#icon-search">
                              </svg>
                            </button>
                          </div>

                          {%- if settings.predictive_search_enabled -%}
                            <div
                              class="predictive-search predictive-search--header color-{{ settings.predictive_search_color_scheme }}"
                              tabindex="-1"
                              data-predictive-search
                            >
                              <div class="predictive-search__loading-state">
                                <svg
                                  aria-hidden="true"
                                  focusable="false"
                                  class="spinner"
                                  viewBox="0 0 66 66"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                                </svg>
                              </div>
                            </div>

                            <span
                              class="predictive-search-status visually-hidden"
                              role="status"
                              aria-hidden="true"
                            ></span>
                          {%- endif -%}
                        </form>
                        {%- if settings.predictive_search_enabled -%}
                          </predictive-search>
                        {%- else -%}
                          </search-form>
                        {%- endif -%}
                        <button
                          type="button"
                          class="search-modal__close-button modal__close-button link link--text focus-inset"
                          aria-label="{{ 'accessibility.close' | t }}"
                        >
                          <svg class="icon icon-close" aria-hidden="true" focusable="false">
                            <use href="#icon-close">
                          </svg>
                        </button>
                      </div>
                    </div>
                  </details>
                </details-modal>
              </li>

            {%- when 'account' -%}
              {%- if shop.customer_accounts_enabled -%}
                {%- liquid
                  if customer
                    assign account_title = 'customer.account_fallback' | t
                  else
                    assign account_title = 'customer.log_in' | t
                  endif
                -%}
                <li class="grid__item" {{ block.shopify_attributes }}>
                  <a
                    class="link"
                    href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                    title="{{ account_title }}"
                    aria-label="{{ account_title }}"
                  >
										{% render 'icon-nav-account' %}
                  </a>
                </li>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <script src="{{ 'mobile-sticky-bar.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "t:sections.mobile-sticky-bar.name",
  "class": "mobile-sticky-bar gradient large-up-hide",
  "limit": 1,
  "enabled_on": {
    "groups": ["custom.additions"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_in_customizer",
      "default": true,
      "label": "Enable test mode",
      "info": "Shows in the theme editor only."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-2"
    },
		{
      "type": "color",
      "id": "counter_color",
      "label": "Counter color",
      "default": "#ffffff"
    },
		{
      "type": "color",
      "id": "counter_bg",
      "label": "Counter background",
      "default": "#171717"
    },
    {
      "type": "paragraph",
      "content": "t:sections.mobile-sticky-bar.settings.paragraph"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "home",
      "name": "t:sections.mobile-sticky-bar.blocks.home.name",
      "limit": 1
    },
    {
      "type": "collection",
      "name": "t:sections.mobile-sticky-bar.blocks.collection.name",
      "limit": 1
    },
    {
      "type": "cart",
      "name": "t:sections.mobile-sticky-bar.blocks.cart.name",
      "limit": 1
    },
    {
      "type": "search",
      "name": "t:sections.mobile-sticky-bar.blocks.search.name",
      "limit": 1
    },
    {
      "type": "wishlist",
      "name": "Wishlist",
      "limit": 1
    },
    {
      "type": "account",
      "name": "t:sections.mobile-sticky-bar.blocks.account.name",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "t:sections.mobile-sticky-bar.name",
      "blocks": [
        {
          "type": "home"
        },
        {
          "type": "collection"
        },
        {
          "type": "cart"
        },
        {
          "type": "wishlist"
        },
        {
          "type": "account"
        }
      ]
    }
  ]
}
{% endschema %}
