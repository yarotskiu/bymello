{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_product_variants %}
  {{ 'product-card-variants.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-swatch.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-swatch-input.css' | asset_url }}" media="print" onload="this.media='all'">
{% endif %}

{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign wishlist_ratio_percent = 100
  if section.settings.image_ratio == 'portrait'
    assign wishlist_ratio_percent = 125
  elsif section.settings.image_ratio == 'custom'
    assign wishlist_ratio_percent = section.settings.custom_image_height
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-mb: {{ section.settings.padding_top_mb }}px;
    --padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
  }

  {%- unless section.settings.image_ratio == 'adapt' -%}
  #bm-wishlist-grid .card,
  #bm-wishlist-grid .card.card--standard,
  #bm-wishlist-grid .card .card__inner,
  #bm-wishlist-grid .card .card__inner.ratio {
    --ratio-percent: {{ wishlist_ratio_percent }}% !important;
  }
  {%- endunless -%}

  #bm-wishlist-grid {
    display: grid;
    list-style: none;
    padding: 0;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    column-gap: var(--grid-mobile-horizontal-spacing);
    row-gap: var(--grid-mobile-vertical-spacing);
  }
  #bm-wishlist-grid .grid__item {
    width: auto;
    max-width: none;
    flex: none;
  }
  #bm-wishlist-grid .card {
    height: auto;
    overflow: visible;
  }
  #bm-wishlist-grid .card__badge {
    display: none;
  }
  #bm-wishlist-grid .bm-wl-remove {
    top: 20px;
    right: 20px;
    box-shadow: none;
    transition: rotate var(--duration-medium) ease-in-out;
  }
  #bm-wishlist-grid .bm-wl-remove svg {
    width: 16px;
    height: 16px;
  }
  #bm-wishlist-grid .bm-wl-remove:hover {
    transform: none;
    rotate: 90deg;
  }
  #bm-wishlist-grid .bm-wishlist-btn {
    display: none;
  }
  #bm-wishlist-grid .card > .card__content {
    display: block;
    height: auto;
    padding: 20px;
  }
  #bm-wishlist-grid .card-information product-form {
    display: block;
    width: 100%;
  }
  #bm-wishlist-grid .card-information product-form .form {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  #bm-wishlist-grid .card-information .bm-inline-size-picker {
    flex: 0 1 auto;
    width: auto;
    height: 38px;
  }
  #bm-wishlist-grid .card-information .bm-inline-size-picker .select {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    width: auto;
    min-width: 74px;
    height: 100%;
    box-sizing: border-box;
    padding: 0 14px !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    outline: none !important;
    border: 1px solid rgba(102, 102, 102, 1) !important;
  }
  #bm-wishlist-grid .card-information .bm-inline-size-picker .select:before,
  #bm-wishlist-grid .card-information .bm-inline-size-picker .select:after {
    content: none !important;
  }
  #bm-wishlist-grid .card-information .bm-inline-size-select,
  #bm-wishlist-grid .card-information .bm-inline-size-select:hover,
  #bm-wishlist-grid .card-information .bm-inline-size-select:focus,
  #bm-wishlist-grid .card-information .bm-inline-size-select:focus-visible {
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    height: 100%;
    box-shadow: none !important;
    outline: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  #bm-wishlist-grid .card-information .bm-inline-size-picker .icon-caret {
    position: static;
    flex: 0 0 auto;
    top: auto;
    right: auto;
    pointer-events: auto;
    cursor: pointer;
  }
  #bm-wishlist-grid .card-information product-form .quick-add__submit {
    flex: 0 0 40px;
    width: 40px;
    min-width: 40px;
    height: 40px;
    min-height: 40px;
    border-radius: 50%;
    padding: 0;
    align-items: center;
    justify-content: center;
  }
  #bm-wishlist-grid .card-information product-form .quick-add__submit > span:not(.bm-size-btn-icon) {
    display: none;
  }
  #bm-wishlist-grid .card-information .bm-size-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    width: 20px;
    height: 20px;
    transition: transform 0.15s ease;
  }
  #bm-wishlist-grid .card-information product-form .quick-add__submit:hover .bm-size-btn-icon {
    transform: scale(1.08);
  }
  #bm-wishlist-grid .card-information .bm-size-btn-icon svg {
    width: 100%;
    height: 100%;
  }
  @media screen and (min-width: 990px) {
    #bm-wishlist-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      column-gap: var(--grid-desktop-horizontal-spacing);
      row-gap: var(--grid-desktop-vertical-spacing);
    }
  }
{%- endstyle -%}

<div class="section-responsive-padding">
  <div class="page-width">
    <ul
      id="bm-wishlist-grid"
      class="product-grid"
      role="list"
      data-show-variants="{{ section.settings.enable_product_variants }}"
    ></ul>
    <div class="bm-wishlist-empty" hidden>
      <p>{{ 'wishlist.empty' | t }}</p>
      <a href="{{ routes.root_url }}" class="button button--primary">{{ 'general.continue_shopping' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_product_variants",
      "label": "Show color options",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4",
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-search.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-search.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-search.settings.image_ratio.options__3.label"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "portrait",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "custom_image_height",
      "min": 60,
      "max": 120,
      "step": 1,
      "unit": "%",
      "label": "Custom image height",
      "default": 120
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 80
    }
  ]
}
{% endschema %}
