{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_breadcrumbs -%}
	{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
  }

  #shopify-section-{{ section.id }} .main-page-banner {
		--padding-top: {{ section.settings.banner_padding_top }}px;
		--padding-bottom: {{ section.settings.banner_padding_bottom }}px;
		--padding-top-mb: {{ section.settings.banner_padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.banner_padding_bottom_mb }}px;
  }
{%- endstyle -%}

{% liquid
	assign title = page.title

	if section.settings.title != blank
		assign title = section.settings.title
	endif
%}

{%- if section.settings.show_breadcrumbs -%}
	<div class="breadcrumbs-wrapper main-page-breadcrumbs color-{{section.settings.breadcrumbs_color_scheme }}">
		<div class="page-width">
	      {% render 'breadcrumbs',
	        title: title,
	        active_breadcrumb_color: section.settings.breadcrumbs_active_color,
	        active_breadcrumb_color_enable: section.settings.breadcrumbs_active_color_enable
	      %}
		</div>
  </div>
{%- endif -%}		

<div class="main-page-banner">
  <div class="main-page-banner__wrapper section-responsive-padding" style="text-align: {{ section.settings.banner_text_alignment }};">
    <div class="page-width{% if template.suffix == 'returns' or template.suffix == 'shipping' or template.suffix == 'terms' or template.suffix == 'support' or template.suffix == 'faq' or template.suffix == 'cookie-policy' or template.suffix == 'privacy-policy' or template.suffix == 'organic-cotton' %} page-width--policy-narrow{% endif %}">
			<h1 class="main-page-title page-title title title-wrapper--no-top-margin inline-richtext {{ section.settings.title_weight }} {{ section.settings.title_size }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text animate--slide-in {% endif %}">
				{% if section.settings.title != blank %}
					{{ section.settings.title }}
				{% else %}
					{{ title | escape }}
				{% endif %}
			</h1>

      {% if section.settings.description != blank %}
        <div class="main-page-description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %} clr-text-{{ section.settings.text_color }}">
          {{ section.settings.description }}
        </div>
      {% endif %}
      {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
      <div
        class="main-page-buttons{% if section.settings.button_label != blank and section.settings.button_label_2 != blank %} main-page-buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {{ section.shopify_attributes }}
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: 1;"
        {% endif %}
      >
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            {% if section.settings.button_link_2 == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link_2 }}"
            {% endif %}
            class="button button--{{ section.settings.button_style_2 }} button--{{ section.settings.button_outline_2 }} button--animate-{{ settings.animations_hover_elements }}"
          >
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% if page.content != blank %}
  <div class="main-page-content section-responsive-padding color-{{ section.settings.content_color_scheme }} gradient">
    <div class="page-width page-width--narrow">
      <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ page.content }}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Banner settings"
    },
		{
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumbs"
    },	
    {
      "type": "color_scheme",
      "id": "breadcrumbs_color_scheme",
      "label": "Breadcrumbs color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_active_color_enable",
      "label": "Use custom active breadcrumb color",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumbs_active_color",
      "label": "Custom color for active breadcrumb",
      "default": "#000000",
      "visible_if": "{{ section.settings.breadcrumbs_active_color_enable == true }}"
    },
		{
      "type": "select",
      "id": "banner_text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Banner content alignment"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Custom heading"
    },
    {
      "type": "select",
      "id": "title_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "title_weight",
			"options": [
        {
          "value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
        },
        {
          "value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
        },
        {
          "value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
        },
        {
          "value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
        }
      ],
      "default": "fw-600",
			"label": "t:settings_schema.global.settings.text_weight.label"
    },

    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Our curated collections are meant to inspire your creative side and provide you with product options.</p>",
      "label": "Text"
    },
		{
			"type": "select",
			"id": "text_color",
			"options": [
				{
					"value": "foreground",
					"label": "Text"
				},
				{
					"value": "foreground-secondary",
					"label": "Text secondary"
				},
				{
					"value": "heading",
					"label": "Heading"
				}
			],
			"default": "foreground",
			"label": "Text color"
    },
		{
      "type": "range",
      "id": "banner_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 70
    },
    {
      "type": "range",
      "id": "banner_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 70
    },
		{
      "type": "range",
      "id": "banner_padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "banner_padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
		{
      "type": "header",
      "content": "Buttons settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
      "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary",
      "label": "t:sections.multirow.settings.button_style.label"
    },
    {
      "type": "select",
      "id": "button_outline",
      "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label",
      "options": [
        {
        "value": "outline-none",
        "label": "None"
        },
        {
        "value": "outline",
        "label": "Outline"
        },
        {
        "value": "outline-hover",
        "label": "Outline on hover"
        }
      ],
      "default": "outline-hover"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
      "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_link_2.label"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "secondary",
      "label": "t:sections.multirow.settings.button_style.label"
    },
    {
      "type": "select",
      "id": "button_outline_2",
      "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label",
      "options": [
        {
        "value": "outline-none",
        "label": "None"
        },
        {
        "value": "outline",
        "label": "Outline"
        },
        {
        "value": "outline-hover",
        "label": "Outline on hover"
        }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ]
}
{% endschema %}
