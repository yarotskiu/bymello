{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_breadcrumbs -%}
	{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .customer {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
	}
{%- endstyle -%}

{%- if section.settings.show_breadcrumbs -%}
  <div class="breadcrumbs-wrapper color-{{ section.settings.breadcrumbs_color_scheme }}">
    <div class="page-width">
      {% render 'breadcrumbs',
        active_breadcrumb_color: section.settings.breadcrumbs_active_color,
        active_breadcrumb_color_enable: section.settings.breadcrumbs_active_color_enable
      %}
    </div>
  </div>
{%- endif -%}

<div class="color-{{ section.settings.section_color_scheme }}">
	<div class="page-width">
  <div class="customer account customer-account section-responsive-padding">
    <div class="customer-account__sidebar">
      <div class="customer-account__sidebar-items">
        <div class="customer-account__sidebar-item {% if request.path == routes.account_url %}active-order-history{% endif %}">
          <a class="h5" href="{{ routes.account_url }}">
            {{ 'customer.orders.order_history' | t }}
            {% render 'icon-caret' %}
          </a>
        </div>
        <div class="customer-account__sidebar-item color-{{ section.settings.color_scheme }}">
          <a class="h5" href="{{ routes.account_addresses_url }}">
            {{ 'customer.account.view_addresses' | t }}
            {% render 'icon-caret' %}
          </a>
        </div>
      </div>
      <a class="customer-account__logout link link-with-underline" href="{{ routes.account_logout_url }}">
				{{ 'customer.orders.log_out' | t }}
      </a>
    </div>

    <div class="customer-account__orders">
      <div class="customer-account__orders-header">
        <h2 class="customer-account__orders-title h3">{{ 'customer.orders.title' | t }}</h2>
      </div>

      {% paginate customer.orders by 50 %}
        {%- if customer.orders.size > 0 -%}
          <table role="table" class="order-history">
            <caption class="visually-hidden">
              {{ 'customer.orders.title' | t }}
            </caption>

            <thead role="rowgroup">
              <tr role="row">
                <th
                  id="ColumnOrder"
                  scope="col"
                  role="columnheader"
                >
                  {{ 'customer.orders.order_number' | t }}
                </th>
                <th
                  id="ColumnDate"
                  scope="col"
                  role="columnheader"
                >
                  {{ 'customer.orders.date' | t }}
                </th>
                <th
                  id="ColumnPayment"
                  scope="col"
                  role="columnheader"
                >
                  {{ 'customer.orders.payment_status' | t }}
                </th>
                <th
                  id="ColumnFulfillment"
                  scope="col"
                  role="columnheader"
                >
                  {{ 'customer.orders.fulfillment_status' | t }}
                </th>
                <th
                  id="ColumnTotal"
                  scope="col"
                  role="columnheader"
                >
                  {{ 'customer.orders.total' | t }}
                </th>
              </tr>
            </thead>

            <tbody role="rowgroup">
              {%- for order in customer.orders -%}
                <tr role="row">
                  <td
                    id="RowOrder"
                    role="cell"
                    headers="ColumnOrder"
                    data-label="{{ 'customer.orders.order_number' | t }}"
                  >
                    <a
                      href="{{ order.customer_url }}"
                      aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                    >
                      {{ order.name }}
                    </a>
                  </td>
                  <td
                    headers="RowOrder ColumnDate"
                    role="cell"
                    data-label="{{ 'customer.orders.date' | t }}"
                  >
                    {% comment %} {{ order.created_at | time_tag: format: 'date' }} {% endcomment %}
                    {{ order.created_at | date: '%b %d, %Y' }}
                  </td>
                  <td
                    headers="RowOrder ColumnPayment"
                    role="cell"
                    data-label="{{ 'customer.orders.payment_status' | t }}"
                  >
                    <span style="color: #fff; background-color: #2CB683; border-radius: 20px;">
                      {{ order.financial_status_label }}
                    </span>
                  </td>
                  <td
                    headers="RowOrder ColumnFulfillment"
                    role="cell"
                    data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                  >
                    {{ order.fulfillment_status_label }}
                  </td>
                  <td
                    headers="RowOrder ColumnTotal"
                    role="cell"
                    data-label="{{ 'customer.orders.total' | t }}"
                  >
                    {{ order.total_net_amount | money }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <div class="customer-account__orders-empty color-{{ section.settings.color_scheme }}">
            <div class="customer-account__orders-empty__icon">
              {%- render 'icon-empty-cart' -%}
            </div>
            <h3>{{ 'customer.orders.none' | t }}</h3>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {%- if paginate.parts.size > 0 -%}
            <nav
              class="pagination"
              role="navigation"
              aria-label="{{ 'general.pagination.label' | t }}"
            >
              <ul role="list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        viewBox="0 0 10 6"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                          fill="currentColor">
                      </svg>
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                        {{- part.title -}}
                      </a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                          {{- part.title -}}
                        </span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        viewBox="0 0 10 6"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                          fill="currentColor">
                      </svg>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumbs_color_scheme",
      "label": "Breadcrumbs color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_active_color_enable",
      "label": "Use custom active breadcrumb color",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumbs_active_color",
      "label": "Custom color for active breadcrumb",
      "default": "#000000",
      "visible_if": "{{ section.settings.breadcrumbs_active_color_enable == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ]
}
{% endschema %}
