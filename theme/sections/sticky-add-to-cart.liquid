{{ 'sticky-add-to-cart.css' | asset_url | stylesheet_tag }}
{%- if section.settings.style == 'default-swatches' -%}
	{{ 'product-card-variants.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
	assign featured_image = product.selected_or_first_available_variant.featured_media
	if product.selected_or_first_available_variant.featured_media == nil and product.featured_media != nil
		assign featured_image = product.featured_media
	endif
%}

<div class="sticky-atc-bar color-{{ section.settings.color_scheme }} global-settings-popup gradient {{ section.settings.style }}" data-style="{{section.settings.style}}">
  <div class="page-width">
    <sticky-atc-bar class="atc-bar-product" data-url="{{ product.url }}">
      <div class="atc-product-media">
				<div class="media media--{{ section.settings.image_ratio }}" {% if section.settings.image_ratio == 'adapt' %}style="padding-bottom: {{ 1 | divided_by: featured_image.aspect_ratio | times: 100 }}%;"{% endif %}>
					{% if product.selected_or_first_available_variant.featured_media != nil %}
						<img id="atc-{{ section.id }}" src="{{ product.selected_or_first_available_variant.featured_media | image_url: width: 80 }}" alt="{{ product.selected_or_first_available_variant.featured_media.alt | escape }}" height="80" width="80" loading="lazy">
					{% elsif product.featured_media != nil %}
						<img id="atc-{{ section.id }}" src="{{ product.featured_media | image_url: width: 80 }}" alt="{{ product.featured_media.alt | escape }}" height="80" width="80" loading="lazy">
					{% else %}
						{{ 'product-1' | placeholder_svg_tag }}
					{% endif %}
				</div>
      </div>

      <div class="atc-product-info{% if section.settings.style != 'default'and section.settings.style != 'default-swatches' %} small-hide{% endif %}">
        <p class="h6 atc-product-title {{ section.settings.heading_font_family }}">
          {{ product.title | escape }}
        </p>

        {% render 'price', 
          product: product, 
          use_variant: true, 
          show_prices: true, 
          show_badges: false 
        %}
      </div>

			{%- if section.settings.style == 'right-side' -%}
				<span class="sticky-atc-bar__close animate-hover-rotate button--animate-{{ settings.animations_hover_elements }} small-hide">
					{% render 'icon-close' %}
				</span>	
			{%- endif -%}			

      <div class="atc-product-form">

				<product-form class="product-form">	
					{%- assign product_form_id = 'product-form-' | append: product.id -%}

					<div class="product-form__error-message-wrapper" role="alert" hidden>
						<svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13">
							<circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
							<circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
							<path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
							<path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
						</svg>
						<span class="product-form__error-message"></span>
					</div>

					{%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
						<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
						
							{%- if section.settings.style == 'default-swatches' and section.settings.product_variants_name != blank  -%}
								{% 
									liquid
									assign color_label_list = section.settings.product_variants_name | replace: ', ', ',' | downcase | split: ','
								%}
								{%- for color_label in color_label_list -%}
									{%- if product.options_by_name[color_label] != blank -%}
										<div class="atc-bar-product__label h6 small-hide medium-hide">
											{{ section.settings.product_variants_name }}
										</div>
									{%- endif -%}
								{%- endfor -%}
							{%- endif -%}

							{%- unless product.has_only_default_variant -%}
								<div class="select {% if section.settings.style == 'default-swatches' %} medium-hide large-up-hide{% endif %}">
									<select name="id" class="select__select" aria-label="Select variant">
										{% for variant in product.variants %}
											<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %} data-price="{{ variant.price | money }}" {% if variant.featured_image != blank %}data-media="{{ variant.featured_image | image_url: width: 80 }}"{% endif %}>
												{{- variant.title -}}
											</option>
										{% endfor %}
									</select>
									{% render 'icon-caret' %}
								</div>
							{%- endunless -%}

							{% if section.settings.style == 'default' %}
								<quantity-input class="quantity">

									<button class="quantity__button no-js-hidden" name="minus" type="button">
										<span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
										{% render 'icon-minus' %}
									</button>

									<input class="quantity__input" type="number" name="quantity" id="Quantity-{{ section.id }}-sticky"
											min="1" value="1" form="{{ product_form_id }}" 
											product-price="{{ product.selected_or_first_available_variant.price }}">

									<button class="quantity__button no-js-hidden" name="plus" type="button">
										<span class="visually-hidden">
											{{ 'products.product.quantity.increase' | t: product: product.title | escape }}
										</span>
										{% render 'icon-plus' %}
									</button>

								</quantity-input>
							{% endif %}

							{% if section.settings.style == 'default-swatches' and section.settings.product_variants_name != blank %}
								{%- assign color_label_list = section.settings.product_variants_name
									| replace: ', ', ','
									| downcase
									| split: ','
								-%}
								{%- for color_label in color_label_list -%}
									{%- if product.options_by_name[color_label] != blank -%}
										{%- assign product_option = product.options_by_name[color_label] -%}
										<div class="atc-bar-product__card-variants-wrapp card-variants-wrapp small-hide no-js-hidden" data-test="{{ color_label }}">
											<sticky-atc-variants class="card-variants">
												{%- assign variant_option = 'option' | append: product_option.position -%}

												{%- capture color_name -%}{{ section.id }}-{{ product.id }}{%- endcapture -%}

												{%- for value in product_option.values -%}
													{%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
													{%- assign variant_for_value = product.variants | where: variant_option, value | first -%}
													<div
														class="card-variant {% if variant_for_value.available == false %} card-variant--disabled{% endif %}"
														data-variant-id="{{ variant_for_value.id }}"
														{% if variant_for_value.featured_media != blank %}
															data-variant-img="{{ variant_for_value.featured_media | image_url: width: 533 }}"
														{% endif %}
														role="button"
														aria-label="Card variant"
														tabindex="0"
													>
														<input
															class="card-variant__radio visually-hidden"
															type="radio"
															name="{{ color_name }}"
															id="{{ color_id }}"
															value="{{ value | escape }}"
															{% if product_option.selected_value == value %}
																checked="checked"
															{% endif %}
														>

														<label class="card-variant__item dropdown-swatch" for="{{ color_id }}">
															<span class="visually-hidden">{{ value }}</span>

															{% render 'swatch', swatch: value.swatch %}
														</label>
													</div>
												{%- endfor -%}
											</sticky-atc-variants>
										</div>
									{%- endif -%}
								{%- endfor -%}
							{% endif %}

                            <button type="submit" name="add" class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button-add-card button--animate-{{ settings.animations_hover_elements }}"
								{% if product.selected_or_first_available_variant.available == false %}disabled{% endif %} tabindex="0">
								<span>
									{%- if product.selected_or_first_available_variant.available -%}
										{{ 'products.product.add_to_cart' | t }}
									{%- else -%}
										{{ 'products.product.sold_out' | t }}
									{%- endif -%}
								</span>
								{%- render 'loading-spinner' -%}
							</button>

					{%- endform -%}
				</product-form>
      </div>
    </sticky-atc-bar>
  </div>
</div>

<script src="{{ 'sticky-add-to-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name":"t:sections.sticky_add_to_cart.name",
  "tag": "section",
  "class": "section section-sticky-atc-bar",
  "templates": [
    "product"
  ],
  "settings": [
		{
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "style",
      "options": [
        {
          "value": "default",
          "label": "t:sections.sticky_add_to_cart.settings.style.default"
        },
        {
          "value": "default-swatches",
          "label": "Color swatch"
        },
        {
          "value": "right-side",
          "label": "t:sections.sticky_add_to_cart.settings.style.right-side"
        }
      ],
      "default": "right-side",
      "label": "t:sections.sticky_add_to_cart.settings.style.label"
    },
    {
      "type": "select",
      "id": "heading_font_family",
      "label": "Heading font family",
      "options": [
        { "value": "font-heading", "label": "Heading" },
        { "value": "font-body", "label": "Body" }
      ],
      "default": "font-body"
    },
  
		{
			"type": "text",
			"id": "product_variants_name",
			"default": "Color",
			"label": "Color variant name",
			"info": "Works with \"Color swatch\" style. Read more about it in the [documentation]( https://docs.muup.co/article/1637-sticky-add-to-cart-section)."
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "adapt",
					"label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
				},
				{
					"value": "landscape",
					"label": "Landscape"
				}
			],
			"default": "adapt",
			"label": "Image ratio"
		},
		{
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary",
      "label": "Button style"
    },
    {
      "type": "select",
      "id": "button_outline",
      "label": "Button outline",
      "options": [
        {
          "value": "outline-none",
          "label": "None"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "outline-hover",
          "label": "Outline on hover"
        }
      ],
      "default": "outline-hover"
    }
  ],
  "presets": [
    {
			"name":"t:sections.sticky_add_to_cart.name"
    }
  ]
}
{% endschema %}