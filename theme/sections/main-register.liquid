{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_breadcrumbs -%}
	{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .customer {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
	}
{%- endstyle -%}

{%- if section.settings.show_breadcrumbs -%}
  <div class="breadcrumbs-wrapper color-{{ section.settings.breadcrumbs_color_scheme }}">
    <div class="page-width">
      {% render 'breadcrumbs',
        active_breadcrumb_color: section.settings.breadcrumbs_active_color,
        active_breadcrumb_color_enable: section.settings.breadcrumbs_active_color_enable
      %}
    </div>
  </div>
{%- endif -%}

<div class="customer register color-{{ section.settings.section_color_scheme }} section-responsive-padding">
	<div class="page-width">
		<svg style="display: none">
			<symbol id="icon-error" viewBox="0 0 13 13">
				<circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
				<circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
				<path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
				<path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
			</symbol>
		</svg>

		<h1 class="title {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
			{{ 'customer.register.title' | t }}
		</h1>

		<div class="description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
			<p>
				{{ 'customer.login_page.description' | t }}
			</p>
		</div>

		<div class="form-wrapper {% if section.settings.image == blank %}no-image{% endif %}">
			{% if section.settings.image != blank %}
				<div class="form-wrapper__img">
					{%- capture sizes -%}
						600px
					{%- endcapture -%}

					{{
						section.settings.image
						| image_url: width: 1200
						| image_tag:
							sizes: sizes,
							alt: section.settings.image.alt,
							widths: '320, 360, 375, 420, 480, 768, 950, 1024, 1200'
					}}
				</div>
			{% endif %}

			{%- form 'create_customer' -%}
				{%- if form.errors -%}
					<h2 class="form__message" tabindex="-1" autofocus>
						<svg aria-hidden="true" focusable="false">
							<use href="#icon-error" />
						</svg>
						{{ 'templates.contact.form.error_heading' | t }}
					</h2>
					<ul>
						{%- for field in form.errors -%}
							<li>
								{%- if field == 'form' -%}
									{{ form.errors.messages[field] }}
								{%- else -%}
									<a href="#RegisterForm-{{ field }}">
										{{ form.errors.translated_fields[field] | capitalize }}
										{{ form.errors.messages[field] }}
									</a>
								{%- endif -%}
							</li>
						{%- endfor -%}
					</ul>
				{%- endif -%}

				<div class="field">
					<label for="RegisterForm-FirstName">
						{{ 'customer.register.first_name' | t }}<span class="contact__required" aria-hidden="true"> *</span>
					</label>

					<input
						type="text"
						name="customer[first_name]"
						id="RegisterForm-FirstName"
						{% if form.first_name %}
							value="{{ form.first_name }}"
						{% endif %}
						autocomplete="given-name"
						aria-required="true"
						required
						placeholder="{{ 'customer.register.placeholder.first_name' | t }}"
					>
				</div>
				<div class="field">
					<label for="RegisterForm-LastName">
						{{ 'customer.register.last_name' | t }}<span class="contact__required" aria-hidden="true">  *</span>
					</label>

					<input
						type="text"
						name="customer[last_name]"
							aria-required="true"
						id="RegisterForm-LastName"
						{% if form.last_name %}
							value="{{ form.last_name }}"
						{% endif %}
						autocomplete="family-name"
						required
						placeholder="{{ 'customer.register.placeholder.last_name' | t }}"
					>
				</div>
				<div class="field">
					<label for="RegisterForm-email">
						{{ 'customer.register.email' | t }}<span class="contact__required" aria-hidden="true">*</span>
					</label>

					<input
						type="email"
						name="customer[email]"
						id="RegisterForm-email"
						{% if form.email %}
							value="{{ form.email }}"
						{% endif %}
						spellcheck="false"
						autocapitalize="off"
						autocomplete="email"
						aria-required="true"
						{% if form.errors contains 'email' %}
							aria-invalid="true"
							aria-describedby="RegisterForm-email-error"
						{% endif %}
						required
						placeholder="{{ 'customer.register.placeholder.email' | t }}"
					>
				</div>
				<span id="RegisterForm-email-error" class="form__message">
					{%- if form.errors contains 'email' -%}
						<svg aria-hidden="true" focusable="false">
							<use href="#icon-error" />
						</svg>
						{{ form.errors.translated_fields.email | capitalize }}
						{{ form.errors.messages.email }}.
					{%- endif -%}
				</span>
				<div class="field">
					<label for="RegisterForm-password">
						{{ 'customer.register.password' | t }}<span class="contact__required" aria-hidden="true">*</span>
					</label>

					<input
						type="password"
						name="customer[password]"
						id="RegisterForm-password"
						aria-required="true"
						{% if form.errors contains 'password' %}
							aria-invalid="true"
							aria-describedby="RegisterForm-password-error"
						{% endif %}
						required
						placeholder="{{ 'customer.register.placeholder.password' | t }}"
					>
				</div>
				<span id="RegisterForm-password-error" class="form__message">
					{%- if form.errors contains 'password' -%}
						<svg aria-hidden="true" focusable="false">
							<use href="#icon-error" />
						</svg>
						{{ form.errors.translated_fields.password | capitalize }}
						{{ form.errors.messages.password }}.
					{%- endif -%}
				</span>
				<div class="form-buttons">
					<button type="submit" class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}">
						{{ 'customer.register.submit' | t }}
					</button>
				</div>
				<div class="create-account-wrapper">
					<div class="create-account-text">Already have an account?</div> 

					<a class="create-account-btn link link-with-underline" href="{{ routes.account_login_url }}">
						{{ 'customer.login_page.sign_in_back' | t }}
					</a>
				</div>
			{%- endform -%}
		</div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumbs_color_scheme",
      "label": "Breadcrumbs color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_active_color_enable",
      "label": "Use custom active breadcrumb color",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumbs_active_color",
      "label": "Custom color for active breadcrumb",
      "default": "#000000",
      "visible_if": "{{ section.settings.breadcrumbs_active_color_enable == true }}"
    },
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "Primary"
				},
				{
					"value": "secondary",
					"label": "Secondary"
				}
			],
			"default": "primary",
			"label": "Button style"
		},
		{
			"type": "select",
			"id": "button_outline",
			"label": "Button outline",
			"options": [
				{
				"value": "outline-none",
				"label": "None"
				},
				{
				"value": "outline",
				"label": "Outline"
				},
				{
				"value": "outline-hover",
				"label": "Outline on hover"
				}
			],
			"default": "outline-hover"
		},
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ]
}
{% endschema %}
