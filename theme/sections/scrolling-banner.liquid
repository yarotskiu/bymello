{{ 'section-scrolling-banner.css' | asset_url | stylesheet_tag: preload: true }}

{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;

		--_c-column-gap: {{ section.settings.column_gap }}px;
		--_c-column-gap-mb: {{ section.settings.column_gap_mb }}px;
		
  }
{%- endstyle -%}

<div class="section-responsive-padding scroller-wrapper color-{{ section.settings.color_scheme }} gradient">
	<marquee-text
		class=" scroller rolling-text"
		data-speed="{{ section.settings.scroll_speed }}"
		data-direction="left"
		{%- if section.settings.bg_hover_1 != blank and section.settings.bg_hover_1 != 'rgba(0,0,0,0)' %}
			data-bg-1="{{ section.settings.bg_hover_1 }}"
		{%- endif -%}
		{%- if section.settings.text_hover_1 != blank and section.settings.text_hover_1 != 'rgba(0,0,0,0)' %}
			data-text-1="{{section.settings.text_hover_1 }}"
		{%- endif -%}
		{%- if section.settings.bg_hover_2 != blank and section.settings.bg_hover_2 != 'rgba(0,0,0,0)' %}
			data-bg-2="{{ section.settings.bg_hover_2 }}"
		{%- endif -%}
		{%- if section.settings.text_hover_2 != blank and section.settings.text_hover_2 != 'rgba(0,0,0,0)' %}
			data-text-2="{{section.settings.text_hover_2 }}"
		{%- endif -%}
		{%- if section.settings.bg_hover_3 != blank and section.settings.bg_hover_3 != 'rgba(0,0,0,0)' %}
			data-bg-3="{{ section.settings.bg_hover_3 }}"
		{%- endif -%}
		{%- if section.settings.text_hover_3 != blank and section.settings.text_hover_3 != 'rgba(0,0,0,0)' %}
			data-text-3="{{section.settings.text_hover_3 }}"
		{%- endif -%}
		{%- if section.settings.bg_hover_4 != blank and section.settings.bg_hover_4 != 'rgba(0,0,0,0)' %}
			data-bg-4="{{ section.settings.bg_hover_4 }}"
		{%- endif -%}
		{%- if section.settings.text_hover_4 != blank and section.settings.text_hover_4 != 'rgba(0,0,0,0)' %}
			data-text-4="{{section.settings.text_hover_4 }}"
		{%- endif -%}
	>
		<ul class="scroller__inner list-unstyled rolling-text-wrapper">
			<li class="rolling-text-item">
				{%- for block in section.blocks -%}
					{% case block.type %}
						{%- when 'icon' -%}
							{%- style -%}
								#Icon-{{ block.id }}-{{ section.id }} {
									--icon-width: {{ block.settings.image_width }}px;
								}
							{%- endstyle -%}

							<div id="Icon-{{ block.id }}-{{ section.id }}" class="scroller-item scroller-item--icon icon">
								<div class="scroller-item--icon-wrap">
									{% if block.settings.image != blank %}
										{%- assign widths = '108' -%}
										{{
											block.settings.image
											| image_url: width: 108
											| image_tag: loading: 'lazy', sizes: '108', widths: widths, alt: block.settings.image.alt
										}}
									{%- else -%}
										{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
									{%- endif -%}
								</div>
							</div>
	
						{%- when 'heading' -%}
							<div style="--_s-clr-text: var({{ block.settings.color }})" class="scroller-item scroller-item--text rte {{ block.settings.text_size }} {{ block.settings.text_weight }}">
								<p class="{{ block.settings.text_size }} {{ block.settings.text_weight }} {% if block.settings.text_size == 'h0' %} {{ block.settings.heading_font_family }} {% endif %}">
									{{ block.settings.text }}
								</p>
							</div>
					{%- endcase -%}
				{%- endfor -%}
			</li>
			<li class="rolling-text-item">
				{%- for block in section.blocks -%}
					{% case block.type %}
						{%- when 'icon' -%}
							{%- style -%}
