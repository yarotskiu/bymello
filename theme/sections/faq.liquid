{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
	#shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
	}
{%- endstyle -%}

<div class="faq color-{{ section.settings.color_scheme }} isolate gradient section-responsive-padding">
	<div class="page-width ">
  <div class="title-wrapper title-wrapper--no-top-margin">
    {%- if section.settings.title != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_weight }} {{ section.settings.heading_font_family }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="description inline-richtext h6 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
        {{ section.settings.description -}}
      </div>
    {%- endif -%}
  </div>

  <div class="faq__wrapper">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="faq__item grid-main grid-main--default col-md-2 col-lg-2">
					{%- if block.settings.heading != blank -%}
						<div class="faq__heading {{ block.settings.heading_font_family }} {{ block.settings.heading_size }} clr-text-{{ block.settings.heading_color }} {{ block.settings.heading_weight }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
							{{ block.settings.heading }}
						</div>
					{%- endif -%}

					{%- if block.settings.description != blank -%}
						<div class="faq__description inline-richtext {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
							{{ block.settings.description }}
						</div>
					{%- endif -%}

					
				</div>
      {% endfor %}
    {% else %}

    {% endif %}
  </div>
	</div>
</div>

<script src="{{ 'featured-slideshow.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Frequently asked questions",
      "label": "t:sections.faq.settings.title.label"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
		{
			"type": "select",
			"id": "heading_weight",
			"options": [
				{
					"value": "fw-400",
					"label": "t:settings_schema.global.settings.text_weight.options__1.label"
				},
				{
					"value": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.options__2.label"
				},
				{
					"value": "fw-600",
					"label": "t:settings_schema.global.settings.text_weight.options__3.label"
				},
				{
					"value": "fw-700",
					"label": "t:settings_schema.global.settings.text_weight.options__4.label"
				}
			],
			"default": "fw-500",
			"label": "t:settings_schema.global.settings.text_weight.label"
		},
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.faq.settings.description.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Frequently asked question",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h6",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Large"
            }
          ],
          "default": "h5",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "select",
          "id": "heading_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground",
          "label": "Heading color"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "options": [
            {
              "value": "fw-400",
              "label": "t:settings_schema.global.settings.text_weight.options__1.label"
            },
            {
              "value": "fw-500",
              "label": "t:settings_schema.global.settings.text_weight.options__2.label"
            },
            {
              "value": "fw-600",
              "label": "t:settings_schema.global.settings.text_weight.options__3.label"
            },
            {
              "value": "fw-700",
              "label": "t:settings_schema.global.settings.text_weight.options__4.label"
            }
          ],
          "default": "fw-600",
          "label": "t:settings_schema.global.settings.text_weight.label"
        },
				{
					"type": "select",
					"id": "heading_font_family",
					"label": "Heading font family",
					"options": [
						{
						"value": "font-heading",
						"label": "Heading"
						},
						{
						"value": "font-body",
						"label": "Body"
						}
					],
					"default": "font-body"
				},
				{
          "type": "inline_richtext",
          "id": "description",
					"default": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.",
          "label": "t:sections.faq.settings.description.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
