{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'featured-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<link rel="stylesheet" href="{{ 'template-collection.css' | asset_url }}" media="print" onload="this.media='all'">

{%- liquid 
	assign slides_per_view = 1.2	
	assign slides_per_view_tb = 2.2
	assign slides_per_view_pc = section.settings.slides_number

	if section.blocks.size < slides_per_view
		assign slides_per_view = section.blocks.size
	endif

	if section.blocks.size < slides_per_view_tb
		assign slides_per_view_tb = section.blocks.size
	endif

	if section.blocks.size < slides_per_view_pc
		assign slides_per_view_pc = section.blocks.size
	endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .featured-slideshow {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;

		/* slider setup */
		--slides-per-view: {{ slides_per_view }};
		--slides-per-view-tb: {{ slides_per_view_tb }};
		--slides-per-view-pc: {{ slides_per_view_pc }};
		/* end slider setup */
	}
{%- endstyle -%}

<featured-slideshow class="featured-slideshow color-{{ section.settings.color_scheme }} isolate gradient section-responsive-padding" data-slides-per-view="{{ section.settings.slides_number }}" data-space-between-pc="{{ settings.spacing_grid_horizontal }}" data-space-between="{{ settings.spacing_grid_horizontal_mb }}">
  <div>
    <div class="title-wrapper title-wrapper--no-top-margin page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_font_family }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
					{{ section.settings.description -}}
        </div>
      {%- endif -%}
    </div>

    <div class="featured-slideshow__wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
			<div class="featured-slideshow__slider page-width">
				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							<div
								id="Slide-{{ section.id }}-{{ forloop.index }}"
								class="swiper-slide"
								role="listitem"
								{% if settings.animations_reveal_on_scroll %}
									data-cascade
									style="--animation-order: {{ forloop.index }};"
								{% endif %}
							>
								<div class="featured-slideshow__item content-container color-{{ block.settings.color_scheme }}">

									{%- if block.settings.image != blank -%}
										<div
											class="featured-slideshow__media"
										>
											<div
												class="media--{{ block.settings.image_ratio }} media global-media-settings gradient"
												{% if block.settings.image_ratio == 'adapt' %}
													style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
												{% elsif block.settings.image_ratio == 'custom' %}
													style="padding-bottom: {{ block.settings.custom_image_height }}%;"
												{% endif %}
											>
												{{
													block.settings.image
													| image_url: width: 1920
													| image_tag:
														widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
														alt: block.settings.image.alt
												}}
											</div>
										</div>
									{%- else -%}
										<div
											class="media--{{ block.settings.image_ratio }} media global-media-settings gradient"
											{% if block.settings.image_ratio == 'adapt' %}
												style="padding-bottom: 100%"
											{% elsif block.settings.image_ratio == 'custom' %}
												style="padding-bottom: {{ block.settings.custom_image_height }}%;"
											{% endif %}
										>
											{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
										</div>
									{%- endif -%}
									<div class="featured-slideshow__title-wrapper title-wrapper--no-top-margin">
										{%- if block.settings.heading != blank -%}
											<h3 class="title inline-richtext {{ block.settings.heading_size }} clr-text-{{ block.settings.heading_color }} {{ block.settings.heading_weight }}">
												{{ block.settings.heading }}
											</h3>
										{%- endif -%}
										{%- if block.settings.button_label != blank -%}
											<a
												{% if block.settings.link %}
													href="{{ block.settings.link }}"
													{% else %}
													role="link" aria-disabled="true"
												{% endif %}
												class="link link-with-underline"
											>
												{{- block.settings.button_label | escape -}}
											</a>
										{%- endif -%}
									</div>
								</div>
							</div>
						{%- else -%}
							{%- for i in (1..8) -%}
								<li
									class="swiper-slide"
									{% if settings.animations_reveal_on_scroll %}
										data-cascade
										style="--animation-order: {{ forloop.index }};"
									{% endif %}
								>
									<div class="featured-slideshow__item content-container color-scheme-2">
										<div
											class="featured-slideshow__media"
										>
											<div
												class="media--square media global-media-settings gradient"
											>
												{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
											</div>
										</div>
										<div class="featured-slideshow__title-wrapper title-wrapper--no-top-margin">

												<h3 class="title inline-richtext">
													{{ 'onboarding.product_title' | t }}
												</h3>
												<a role="link" aria-disabled="true"
													class="link"
												>
													{{ 'general.button' | t }}
												</a>
										</div>	
									</div>
								</li>
							{%- endfor -%}
						{%- endfor -%}
					</div>
				</div>
			</div>
		</div>
	</div>
</featured-slideshow>


<script src="{{ 'featured-slideshow.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "Featured slideshow",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
		"templates": ["password"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured slideshow",
      "label": "t:sections.featured-collection.settings.title.label"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "slides_number",
      "min": 1,
      "max": 4,
      "step": 0.2,
      "label": "Number of slides on desktop",
      "default": 3.2
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ],
	"blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
				{
					"type": "color_scheme",
					"id": "color_scheme",
					"label": "t:sections.all.colors.label",
					"info": "t:sections.all.colors.has_cards_info",
					"default": "scheme-2"
				},
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "select",
					"id": "image_ratio",
					"options": [
						{
							"value": "adapt",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
						},
						{
							"value": "portrait",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
						},
						{
							"value": "square",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
						},
						{
							"value": "landscape",
							"label": "Landscape"
						},
						{
							"value": "custom",
							"label": "Custom"
						}
					],
					"default": "adapt",
					"label": "t:sections.main-list-collections.settings.image_ratio.label"
				},
				{
					"type": "range",
					"id": "custom_image_height",
					"min": 40,
					"max": 120,
					"step": 1,
					"unit": "%",
					"label": "Custom image height",
					"default": 100
				},
				{
          "type": "inline_richtext",
          "id": "heading",
          "default": "Add campaign or promotional text here",
          "label": "Heading"
        },
				{
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h6",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Large"
            }
          ],
          "default": "h6",
          "label": "t:sections.all.heading_size.label"
        },
				{
          "type": "select",
          "id": "heading_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground",
          "label": "Heading color"
        },
				{
					"type": "select",
					"id": "heading_weight",
					"options": [
						{
							"value": "fw-400",
							"label": "t:settings_schema.global.settings.text_weight.options__1.label"
						},
						{
							"value": "fw-500",
							"label": "t:settings_schema.global.settings.text_weight.options__2.label"
						},
						{
							"value": "fw-600",
							"label": "t:settings_schema.global.settings.text_weight.options__3.label"
						},
						{
							"value": "fw-700",
							"label": "t:settings_schema.global.settings.text_weight.options__4.label"
						}
					],
					"default": "fw-500",
					"label": "t:settings_schema.global.settings.text_weight.label"
				},
				{
          "type": "inline_richtext",
          "id": "button_label",
          "label": "Button label",
					"default": "Button label"
        },
				{
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured slideshow",
			"blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}