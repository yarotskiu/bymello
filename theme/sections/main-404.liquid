{%- if section.settings.show_breadcrumbs -%}
	{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<style type="text/css">
  #shopify-section-{{ section.id }} .template-404 {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;	
	}

    .image-404__wrapper {
      max-width: 48.5rem;
      width: 100%;
      margin: 0 auto 2rem;
    }

    .image-404__wrapper img {
      width: 100%;
      height: 100%;
			border-radius: var(--media-radius);
    }

    .title-404 {
      max-width: 745px;
      margin: 0 auto var(--title-space-bottom);
    }

    .description-404 {
      color: rgb(var(--color-secondary-foreground));
      max-width: 65rem;
      width: 100%;
      margin: 0 auto;
    }

    .button-404 {
      margin-top: var(--button-space-top, 0);
    }

    @media screen and (max-width: 749px) {
      .button-404 {
				margin-top: var(--button-space-top-mobile, 0);
			}

			.title-404 {
				margin: 0 auto var(--title-space-bottom-mobile);
			}
    }
</style>

{%- if section.settings.show_breadcrumbs -%}
    <div class="breadcrumbs-wrapper collection-hero-breadcrumbs color-{{section.settings.breadcrumbs_color_scheme }}">
		<div class="page-width">
      	{% render 'breadcrumbs', active_breadcrumb_color: section.settings.breadcrumbs_active_color, active_breadcrumb_color_enable: section.settings.breadcrumbs_active_color_enable %}
		</div>
  </div>
{%- endif -%}		

<div class="template-404 section-responsive-padding page-width center color-{{ section.settings.section_color_scheme }}">
  {% if section.settings.image != blank %}
    <div class="image-404__wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <img src="{{ section.settings.image | image_url }}" loading="lazy" alt="{{ section.settings.image.alt | escape }}" width="1046" height="365">
    </div>
  {% endif %}

  <h1 class="title-404 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
    {{ 'templates.404.title' | t }}
  </h1>

  {% if section.settings.text != blank %}
    <div class="rte description-404{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ section.settings.text }}
    </div>
  {% endif %}

  {% if section.settings.show_continue_btn %}
    <a href="{{ routes.root_url }}" class="button button-404 button--animate-{{ settings.animations_hover_elements }} button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }}">
			{{ 'general.home_page' | t }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main 404",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumbs_color_scheme",
      "label": "Breadcrumbs color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_active_color_enable",
      "label": "Use custom active breadcrumb color",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumbs_active_color",
      "label": "Custom color for active breadcrumb"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label",
			"visible_if": "{{ section.settings.breadcrumbs_active_color_enable == true }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Please go to homepage to procced further.</p>",
      "label": "t:sections.image-with-text.blocks.text.settings.text.label"
    },
    {
      "type": "checkbox",
      "id": "show_continue_btn",
      "label": "Show continue button",
      "default": false
    },
    {
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "Primary"
				},
				{
					"value": "secondary",
					"label": "Secondary"
				}
			],
			"default": "primary",
			"label": "Button style"
		},
		{
			"type": "select",
			"id": "button_outline",
			"label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label",
			"options": [
				{
				"value": "outline-none",
				"label": "None"
				},
				{
				"value": "outline",
				"label": "Outline"
				},
				{
				"value": "outline-hover",
				"label": "Outline on hover"
				},
			],
			"default": "outline-hover",
		},
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ]
}
{% endschema %}
