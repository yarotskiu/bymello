{{ 'section-showcase.css' | asset_url | stylesheet_tag: preload: true }}

{%- style -%}
  #shopify-section-{{ section.id }} {
		--padding-top: {{ section.settings.padding_top }}px;
		--padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;	

		--items-per-view: {{ section.settings.columns_number_mb }};
		--items-per-view-tb: {{ section.settings.columns_number | plus: section.settings.columns_number_mb | divided_by: 2 }};
		--items-per-view-pc: {{ section.settings.columns_number }};
		--_animation-duration: {{ section.settings.scroll_speed }}s;
  }
{%- endstyle -%}

{%- liquid
	assign banner_direction = 'left'

	if section.settings.scroll_direction == 'reverse'
		assign banner_direction = 'right'
	endif
-%}

<div class="showcase isolate section-responsive-padding color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.title != blank or section.settings.description != blank -%}
    <div class="page-width">
      <div class="title-wrapper title-wrapper--no-top-margin">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }} {{ section.settings.heading_font_family }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--text {% endif %}">
            {{ section.settings.description -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

	<div class="showcase__content vertical-alignment--{{ section.settings.vertical_alignments }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
		<showcase-scroller class="showcase-scroller" data-speed="fast" data-direction="{{ banner_direction }}">
			<div class="showcase-scroller__wrapper">
				<ul class="showcase-scroller__inner list-unstyled" role="list">
					{%- for i in (1..8) -%}
						<li role="listitem">
							{% if section.blocks.size > 0 %}
								{%- for block in section.blocks -%}
									{% case block.type  %}
										{% when 'item' %}
											<div id="Showcase-Item-{{ section.id }}-{{ block.id }}" class="showcase-scroller__item">
												{%- if block.settings.image_ratio == 'custom' -%}
													{%- style -%}
														#Showcase-Item-{{ section.id }}-{{ block.id }} {
															{% if block.settings.image_ratio == 'custom' %}
																--image-height: {{ block.settings.custom_image_height}}%;
															{% endif %}
														}
													{%- endstyle -%}
												{%- endif -%}

												{% if block.settings.link != blank %}
													<a href="{{ block.settings.link }}">
												{% endif %}
												<div class="showcase-scroller__image-wrapper color-{{ block.settings.color_scheme }}">
													<div
														class="media media--{{ block.settings.image_ratio }} media--transparent"
														{% if block.settings.image_ratio == 'adapt' %}
															{% if block.settings.image != blank %}
																style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
															{% else %}
																style="padding-bottom: 100%;"
															{% endif %}
														{% endif %}
													>
														{% if block.settings.image != blank %}
															{% capture sizes %}
																	(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 20 }}px,
																	(min-width: 750px) calc((100vw - 130px)), calc((100vw - 50px))
																{% endcapture %}
															{{
																block.settings.image
																| image_url: width: 600
																| image_tag:
																	loading: 'lazy',
																	widths: '50, 75, 100, 150, 200, 300, 400, 450, 500, 550, 600, 750, 1000, 1250, 1500, 1750',
																	alt: block.settings.image.alt,
																	sizes: sizes,
																	class: 'showcase-scroller__image'
															}}
														{% else %}
															{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
														{% endif %}
													</div>

													{% if block.settings.heading != blank %}
														<h3 class="showcase-scroller__image-caption h5 clr-text-{{ block.settings.heading_color }}">
															{{ block.settings.heading }}
														</h3>
													{% endif %}
												</div>

												{% if block.settings.link != blank %}
													</a>
												{% endif %}
											</div>
									{% endcase %}
								{%- endfor -%}
							{% else %}
								{%- for i in (1..4) -%}
									<div class="showcase-scroller__item">
										<div class="showcase-scroller__image-wrapper">
											<div
												class="media media--square media--transparent"
											>
												{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
											</div>

											<h3 class="showcase-scroller__image-caption h5">{{ 'general.empty.heading' | t }}</h3>
										</div>
									</div>
								{%- endfor -%}
							{% endif %}
						</li>
					{%- endfor -%}
				</ul>
			</div>
		</showcase-scroller>
	</div>
  
</div>

<script src="{{ 'showcase.js' | asset_url }}" type="module" defer="defer"></script>

{% schema %}
{
  "name": "Showcase",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Showcase",
      "label": "t:sections.collection-list.settings.title.label"
    },
		{
			"type": "select",
			"id": "heading_font_family",
			"label": "Heading font family",
			"options": [
				{
				"value": "font-heading",
				"label": "Heading"
				},
				{
				"value": "font-body",
				"label": "Body"
				}
			],
			"default": "font-heading"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
		{
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed",
      "default": 80
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "reverse",
          "label": "Reverse"
        }
      ],
      "default": "default",
      "label": "Scroll direction"
    },
    {
      "type": "range",
      "id": "columns_number",
      "min": 2,
      "max": 5,
      "step": 0.2,
      "label": "Number of columns on desktop",
      "default": 3.2
    },
    {
      "type": "range",
      "id": "columns_number_mb",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Number of columns on mobile",
      "default": 1.2
    }, 
		{
			"type": "select",
			"id": "vertical_alignments",
			"label": "Vertical alignments",
			"options": [
				{
				"value": "top",
				"label": "Top"
				},
				{
				"value": "center",
				"label": "Center"
				},
				{
				"value": "bottom",
				"label": "Bottom"
				},

			],
			"default": "bottom",
		},
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
				{
					"type": "color_scheme",
					"id": "color_scheme",
					"label": "t:sections.all.colors.label",
					"info": "t:sections.all.colors.has_cards_info",
					"default": "scheme-6"
				},
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
				{
					"type": "select",
					"id": "image_ratio",
					"options": [
						{
							"value": "adapt",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
						},
						{
							"value": "portrait",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
						},
						{
							"value": "square",
							"label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
						},
						{
							"value": "landscape",
							"label": "Landscape"
						},
						{
							"value": "custom",
							"label": "Custom"
						}
					],
					"default": "adapt",
					"label": "t:sections.main-list-collections.settings.image_ratio.label"
				},
				{
					"type": "range",
					"id": "custom_image_height",
					"min": 40,
					"max": 120,
					"step": 1,
					"unit": "%",
					"label": "Custom image height",
					"default": 100
				},
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_color",
          "options": [
            {
              "value": "foreground",
              "label": "Text"
            },
            {
              "value": "foreground-secondary",
              "label": "Text secondary"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "foreground",
          "label": "Heading color"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Showcase",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
