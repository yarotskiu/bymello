{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_breadcrumbs -%}
	{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .customer {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
		--padding-top-mb: {{ section.settings.padding_top_mb }}px;
		--padding-bottom-mb: {{ section.settings.padding_bottom_mb }}px;
	}
{%- endstyle -%}

{%- if section.settings.show_breadcrumbs -%}
  <div class="breadcrumbs-wrapper color-{{ section.settings.breadcrumbs_color_scheme }}">
    <div class="page-width">
      {% render 'breadcrumbs',
        active_breadcrumb_color: section.settings.breadcrumbs_active_color,
        active_breadcrumb_color_enable: section.settings.breadcrumbs_active_color_enable
      %}
    </div>
  </div>
{%- endif -%}

<div class="customer section-responsive-padding login section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }}">
	<div class="page-width">
  <h1 id="recover" class="title title-wrapper--no-top-margin {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" tabindex="-1">
    {{ 'customer.recover_password.title' | t }}
  </h1>
  <div>
    <div class="description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p>
        {{ 'customer.recover_password.subtext' | t }}
      </p>
    </div>
    <div class="form-wrapper {% if section.settings.image == blank %}no-image{% endif %}">
      {% if section.settings.image != blank %}
				<div class="form-wrapper__img {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
					{%- capture sizes -%}
						600px
					{%- endcapture -%}
			
					{{
						section.settings.image
						| image_url: width: 1200
						| image_tag:
						sizes: sizes,
						alt: section.settings.image.alt,
						widths: '320, 360, 375, 420, 480, 768, 950, 1024, 1200'
					}}
				</div>
      {% endif %}

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="field {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <label for="RecoverEmail">
            {{ 'customer.login_page.email' | t }}<span class="contact__required" aria-hidden="true">*</span>
          </label>

          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
						placeholder="{{ 'customer.login_page.placeholder.email' | t }}"
          >
        </div>
				<small id="RecoverEmail-email-error" class="form__message">
					{%- if form.errors -%}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ form.errors.messages.form }}
					{%- endif -%}
				</small>

        <div class="form-buttons {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <button type="submit" class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}">
						{{ 'customer.login_page.submit' | t }}
          </button>

          <a class="link link-with-underline" href="#login">
						{{ 'customer.login_page.cancel' | t }}
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>

  {% comment %} Login {% endcomment %}

  <h1 id="login" class="title title-wrapper--no-top-margin {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" tabindex="-1">
    {{ 'customer.login_page.title' | t }}
  </h1>

  <div>
    <div class="description rte {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p>
        {{ 'customer.login_page.description' | t }}
      </p>
    </div>

    <div class="form-wrapper {% if section.settings.image == blank %}no-image{% endif %}">
			{% if section.settings.image != blank %}
				<div class="form-wrapper__img {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
					{%- capture sizes -%}
						600px
					{%- endcapture -%}
		
					{{
					section.settings.image
					| image_url: width: 1200
					| image_tag:
						sizes: sizes,
						alt: section.settings.image.alt,
						widths: '320, 360, 375, 420, 480, 768, 950, 1024, 1200'
					}}
				</div>
			{% endif %}

      {%- form 'customer_login', novalidate: 'novalidate' -%}

				{%- if recover_success == true -%}
					<h3 class="form__message" tabindex="-1" autofocus>
						<svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
							<path d="M6.5 12.35C9.73087 12.35 12.35 9.73086 12.35 6.5C12.35 3.26913 9.73087 0.65 6.5 0.65C3.26913 0.65 0.65 3.26913 0.65 6.5C0.65 9.73086 3.26913 12.35 6.5 12.35Z" fill="#428445" stroke="white" stroke-width="0.7"/>
							<path d="M5.53271 8.66357L9.25213 4.68197" stroke="white"/>
							<path d="M4.10645 6.7688L6.13766 8.62553" stroke="white">
						</svg>
						{{ 'customer.recover_password.success' | t }}
					</h3>
				{%- endif -%}
				<h2 class="form__message" tabindex="-1" autofocus>

					{%- if form.errors -%}
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </svg>
            {{ 'templates.contact.form.error_heading' | t }}

						{%- endif -%}
          </h2>

					{%- if form.errors -%}
						{{ form.errors | default_errors }}
					{%- endif -%}

        <div class="field {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <label for="CustomerEmail">
            {{ 'customer.login_page.email' | t }} <span class="contact__required" aria-hidden="true">*</span>
          </label>

          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.placeholder.email' | t }}"
          >
        </div>

        {%- if form.password_needed -%}
          <div class="field {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <label for="CustomerPassword">
              {{ 'customer.login_page.password' | t }}<span class="contact__required" aria-hidden="true">*</span>
            </label>

            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.placeholder.password' | t }}"
            >
          </div>
        {%- endif -%}
        <div class="form-buttons {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <button type="submit" class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}">
						{{ 'customer.login_page.sign_in' | t }}
          </button>

          <a class="link link-with-underline" href="#recover">
						{{ 'customer.login_page.forgot_password' | t }}
          </a>
        </div>
        <div class="create-account-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <div class="create-account-text">{{ 'customer.login_page.create_account_text' | t }}</div>
          <a class="create-account-btn link link-with-underline" href="{{ routes.account_register_url }}">
            {{ 'customer.login_page.create_account' | t }}
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>

  {%- if shop.checkout.guest_login -%}
    <div class="guest-login">
      <hr>
      <h2 class="guest-login__title">{{ 'customer.login_page.guest_title' | t }}</h2>

      {%- form 'guest_login' -%}
        <button class="button button--{{ section.settings.button_style }} button--{{ section.settings.button_outline }} button--animate-{{ settings.animations_hover_elements }}">
					{{ 'customer.login_page.guest_continue' | t }}
        </button>
      {%- endform -%}
    </div>
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "breadcrumbs_color_scheme",
      "label": "Breadcrumbs color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "breadcrumbs_active_color_enable",
      "label": "Use custom active breadcrumb color",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumbs_active_color",
      "label": "Custom color for active breadcrumb",
      "default": "#000000",
      "visible_if": "{{ section.settings.breadcrumbs_active_color_enable == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary",
      "label": "Button style"
    },
    {
      "type": "select",
      "id": "button_outline",
      "label": "Button outline",
      "options": [
        {
        "value": "outline-none",
        "label": "None"
        },
        {
        "value": "outline",
        "label": "Outline"
        },
        {
        "value": "outline-hover",
        "label": "Outline on hover"
        }
      ],
      "default": "outline-hover"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 74
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 74
    },
		{
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top_mb",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom_mb",
      "default": 56
    },
  ]
}
{% endschema %}
