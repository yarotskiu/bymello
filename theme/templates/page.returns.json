          "settings": {
            "heading": "",
            "text": "<p>We want you to be completely happy with your purchase. If an item didn't work out — wrong size, colour, or just not what you expected — we understand that's part of online shopping, and we've tried to make returns as simple and hassle-free as possible.</p>",
            "heading_color": "secondary"
          }
