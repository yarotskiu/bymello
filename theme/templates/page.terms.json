        "item_VkLhrg": {
          "type": "item",
          "settings": {
            "heading": "",
            "text": "<p>We respect the privacy of all customers and their personal information. Information collected will be used solely by us to conduct our business. Your personally identifiable visitor information will not be disclosed to third parties, other than for the purpose of completing transaction, (i.e. processing payments or shipping packages). We will only ask for and use relevant personal information as necessary.</p>",
            "heading_color": "secondary"
