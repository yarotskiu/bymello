{% comment %}
  Renders social icons.
  Accepts:
  - class: {String} a class to be added to the <ul> element (optional).
  - item-class: {String} a class to be added to the <li> element (optional).
	-style: {String} Style of social-icon.
  - show_placeholders: {Boolean} render Facebook and Pinterest even without a
    link, as disabled icons (optional).

  Usage:
  {% render 'social-icons',
    class: 'my-class'
    item-class: 'my-item-class',
		style: 'rounded',
    show_placeholders: true,
  %}
{% endcomment %}

<ul class="list-unstyled list-social{% if class %} {{ class}}{% endif %}" role="list">
  {%- if settings.social_linkedin_link != blank -%}
    <li class="list-social__item {% if style != blank %} list-social__item--{{ style }} {% endif %} {% if style == 'rounded' %} button--animate-{{ settings.animations_hover_elements }} {% endif %}">
      <a href="{{ settings.social_linkedin_link }}" class="link list-social__link" aria-label="{{ 'general.social.links.linkedin' | t }}" target="_blank" rel="nofollow" tabindex="0">
				{%- render 'icon-linkedin' -%}
        <span class="visually-hidden">{{ 'general.social.links.linkedin' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_facebook_link != blank or show_placeholders -%}
    <li class="list-social__item list-social__item--{{ style }} {% if style == 'rounded' %} button--animate-{{ settings.animations_hover_elements }} {% endif %}">
			{%- if settings.social_facebook_link != blank -%}
				<a href="{{ settings.social_facebook_link }}" class="link list-social__link" aria-label="{{ 'general.social.links.facebook' | t }}" target="_blank" rel="nofollow">
					{%- render 'icon-facebook' -%}
					<span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
				</a>
			{%- else -%}
				<span class="list-social__link" aria-disabled="true">
					{%- render 'icon-facebook' -%}
					<span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
				</span>
			{%- endif -%}
    </li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li class="list-social__item list-social__item--{{ style }} {% if style == 'rounded' %} button--animate-{{ settings.animations_hover_elements }} {% endif %}">
      <a href="{{ settings.social_instagram_link }}" class="link list-social__link" aria-label="{{ 'general.social.links.instagram' | t }}" target="_blank" rel="nofollow">
				{%- render 'icon-instagram' -%}
        <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
