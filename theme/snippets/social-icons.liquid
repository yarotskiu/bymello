      <a href="{{ settings.social_twitter_link }}" class="link list-social__link" aria-label="{{ 'general.social.links.twitter' | t }}" target="_blank" rel="nofollow">
				{%- render 'icon-twitter' -%}
        <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank or show_placeholders -%}
    <li class="list-social__item list-social__item--{{ style }} {% if style == 'rounded' %} button--animate-{{ settings.animations_hover_elements }} {% endif %}">
			{%- if settings.social_pinterest_link != blank -%}
