{% comment %}
  Renders complementary-product

  Accepts:
	-- product: {Object}
	-- image_ratio: {String}
	-- color_scheme: {String}

  Usage:
  {% render 'complementary-product' %}
{% endcomment %}

{% liquid
	assign unique_id = section.id
	if unique_id == blank
		assign unique_id = product.handle
	endif
%}

<div
	class="complementary-product {% if color_scheme != blank %} color-{{ color_scheme }}{% endif %}"
>
	<a
		href="{{ product.url }}"
		class="link link--text"
		tabindex="0"
	>
		{%- if product.featured_media != blank -%}
			<img
				class="complementary-product__image {% if image_ratio != blank %} complementary-product__image--{{ image_ratio }} {% endif %}"
				src="{{ product.featured_media | image_url: width: 150 }}"
				alt="{{ product.featured_media.alt }}"
				width="50"
				 loading="lazy"
				height="{{ 50 | divided_by: product.featured_media.preview_image.aspect_ratio }}"
			>
		{%- else -%}
			{{ 'product-1' | placeholder_svg_tag }}
		{%- endif -%}
		<div class="complementary-product__content">

			<p class="complementary-product__heading">{{ product.title | escape }}</p>
			{% if product.type != blank %}
				<p class="complementary-product__type">{{ product.type | escape }}</p>
			{% endif %}

			{% render 'price', product: product, use_variant: true, show_badges: false %}

			{% comment %} TODO: check form for first product dont render {% endcomment %}
			{%- assign product_form_id = 'product-form-' | append: unique_id -%}
			<product-form
				class="product-form"
				data-section-id="{{ unique_id }}"
			>
				<div class="product-form__error-message-wrapper" role="alert" hidden>
					<svg
						aria-hidden="true"
						focusable="false"
						class="icon icon-error"
						viewBox="0 0 13 13"
					>
						<circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
						<circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
						<path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
						<path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
					</svg>
					<span class="product-form__error-message"></span>
				</div>

				{%- form 'product',
					product,
					id: product_form_id,
					class: 'form',
					novalidate: 'novalidate',
					data-type: 'add-to-cart-form'
				-%}
					<input
						type="hidden"
						name="id"
						value="{{ product.selected_or_first_available_variant.id }}"
						{% if product.selected_or_first_available_variant.available == false %}
							disabled
						{% endif %}
						class="product-variant-id"
					>

					<div class="product-form__buttons">
						{%- liquid
							assign check_against_inventory = true
							if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
								assign check_against_inventory = false
							endif
							if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
								assign quantity_rule_soldout = true
							endif
						-%}
					{%- if product.variants.size > 1 -%}
						<modal-opener data-modal="#QuickAdd-{{ product.id }}">
							<button
								id="ProductSubmitButton-{{ unique_id }}"
								type="button"
								name="add"
								class="product-form__submit product-form__submit--icon button  {% if button_style != blank %} button--{{button_style}} button--{{ button_outline }} {% else %} button--outline-hover {% endif %} button--animate-{{ settings.animations_hover_elements }}"
								aria-label="{{ product.title }}"
								data-product-url="{{ product.url }}"
								data-initial-product-id="{{ product.id }}"
								{% if product.selected_or_first_available_variant.available == false
									or quantity_rule_soldout
								%}
									disabled
								{% endif %}
							>
								<span>
									{%- render 'icon-plus' -%}
								</span>
								{%- render 'loading-spinner' -%}
							</button>
						</modal-opener>
						<quick-add-modal id="QuickAdd-{{ product.id }}" class="quick-add-modal">
							<popup-overlay class="popup-overlay"></popup-overlay>
							<div
								role="dialog"
								aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
								aria-modal="true"
								class="quick-add-modal__content global-settings-popup"
								tabindex="-1"
							>
								<button
									class="drawer__close button--animate-{{ settings.animations_hover_elements }}"
									type="button"
									id="ModalClose-{{ product.id }}"
									aria-label="{{ 'accessibility.close' | t }}"
								>
									{% render 'icon-close' %}
								</button>
								<div id="QuickAddInfo-{{ product.id }}" class="quick-add-modal__content-info"></div>
							</div>
						</quick-add-modal>
					{%- else -%}
						<button
							id="ProductSubmitButton-{{ unique_id }}"
							type="submit"
							name="add"
							class="product-form__submit product-form__submit--icon button  {% if button_style != blank %} button--{{button_style}} button--{{ button_outline }} {% else %} button--outline-hover {% endif %} button--animate-{{ settings.animations_hover_elements }}"
							aria-label="{{ product.title }}"
							{% if product.selected_or_first_available_variant.available == false
								or quantity_rule_soldout
							%}
								disabled
							{% endif %}
						>
							<span>
								{%- render 'icon-plus' -%}
							</span>
							{%- render 'loading-spinner' -%}
						</button>
					{%- endif -%}
					</div>
				{%- endform -%}
			</product-form> 
		</div>
	</a>
</div>