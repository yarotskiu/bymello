{% comment %}
  Renders an article card for a given blog with settings to either show the image or not.

  Accepts:
  - blog: {Object} Blog object
  - article: {Object} Article object
  - media_aspect_ratio: {String} The setting changes the aspect ratio of the article image, if shown
  - media_height: {String} The setting changes the height of the article image. Overrides media_aspect_ratio.
  - show_image: {String} The setting either show the article image or not. If it's not included it will show the image by default
  - show_date: {String} The setting either show the article date or not. If it's not included it will not show the image by default
  - show_author: {String} The setting either show the article author or not. If it's not included it will not show the author by default
  - show_badge: {String} The setting either show the blog badge or not.
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)

  Usage:
  {% render 'article-card' blog: blog, article: article, show_image: section.settings.show_image %}
{% endcomment %}


{%- if article and article != empty -%}
  {%- liquid
    assign ratio = 1
    if media_aspect_ratio != null
      assign ratio = media_aspect_ratio
    endif
  -%}
  <div class="article-card-wrapper card-wrapper underline-links-hover">
    {% comment %} <article aria-labelledby="Article-{{ article.id }}"> {% endcomment %}
    <div
      class="
        card article-card
        card--{{ settings.blog_card_style }}
				alignment-{{ settings.blog_card_text_alignment }}
        {% if media_height and media_height != 'adapt' %} article-card__image--{{ media_height }}{% endif %}
        {% if article.image and show_image == true %} card--media{% else %} card--text{% endif %}
        {% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %}
        {% if settings.blog_card_style == 'card' and media_height == nil and article.image == empty or show_image == false %} ratio{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
			{%- if show_image == true -%}
				<div
					class="card__inner {% if settings.blog_card_style == 'standard' %} ratio color-{{ settings.blog_card_color_scheme }} gradient{% endif %}{% if article.image and show_image == true or settings.blog_card_style == 'standard' %} ratio{% endif %}"
					style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
				>
					<a href="{{ article.url }}" class="acticle-card__image-link" aria-label="{{ article.title | truncate: 50 | escape }}" tabindex="-1"></a>

					{%- if article.image -%}
						<div class="article-card__image-wrapper card__media">
							<div
								class="article-card__image media media--hover-effect"
								{% if section.settings.media_height == 'adapt' %}
									style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
								{% endif %}
							>
								{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
								<img
									srcset="
										{%- if article.image.src.width >= 165 -%}{{ article.image.src | image_url: width: 360 }} 165w,{%- endif -%}
										{%- if article.image.src.width >= 360 -%}{{ article.image.src | image_url: width: 720 }} 360w,{%- endif -%}
										{%- if article.image.src.width >= 533 -%}{{ article.image.src | image_url: width: 720 }} 533w,{%- endif -%}
										{%- if article.image.src.width >= 720 -%}{{ article.image.src | image_url: width: 1000 }} 720w,{%- endif -%}
										{%- if article.image.src.width >= 1000 -%}{{ article.image.src | image_url: width: 1500 }} 1000w,{%- endif -%}
										{%- if article.image.src.width >= 1500 -%}{{ article.image.src | image_url: width: 1920 }} 1500w,{%- endif -%}
										{{ article.image.src | image_url }} {{ article.image.src.width }}w
									"
									src="{{ article.image.src | image_url: width: 1920 }}"
									sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width }}px, (min-width: 750px) calc((100vw)), calc((100vw))"
									alt="{{ article.image.src.alt | escape }}"
									class="motion-reduce"
									{% unless lazy_load == false %}
										loading="lazy"
									{% endunless %}
									width="{{ article.image.width }}"
									height="{{ article.image.height }}"
								>
								{% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
							</div>
						</div>
					{%- endif -%}

					<div class="card__content">
						<div class="card__information">

							{%- if show_comments or show_author -%}
								<div class="article-card__info caption-with-letter-spacing">

									{%- if article.comments_count > 0  -%}
										<span>{{ 'blogs.article.comments' | t: count: article.comments_count }}</span>
									{%- endif -%}
									{%- if show_author -%}
										<span>{{ article.author }}</span>
									{%- endif -%}
								</div>
							{%- endif -%}

							<h3 class="card__heading{% if show_description %} h2{% endif %}">
								<a href="{{ article.url }}" class="full-unstyled-link">
									{{ article.title | escape }}
								</a>
							</h3>

							{%- if show_description == 'show_all' or show_description == 'show_first' and is_first_article -%}
								{%- if article.excerpt_or_content.size > 0 -%}
									<p class="article-card__excerpt rte-width">
										{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
									</p>
								{%- endif -%}
							{%- endif -%}

						{%- if show_date -%}
								<div class="article-card__footer">
										<span class="article-card__date circle-divider">{{ article.published_at | date: '%-d %B' }}</span>
								</div>
						{%- endif -%}
						</div>

						<div class="card__badge {{ settings.badge_position }}">
							{%- if show_badge -%}
								<span class="badge article-card__badge {{ settings.badge_text_weight }}">{{ 'blogs.article.blog' | t }}</span>
							{%- endif -%}
							{% for tag in article.tags %}
								<a
									href="{{ blog.url }}/tagged/{{ tag.handle }}"
									class="article-card__badge badge button--animate-{{ settings.animations_hover_elements }} {{ settings.badge_text_weight }}"
								>
									{{ tag }}
								</a>
							{% endfor %}
						</div>
					</div>
				</div>
			{%- endif -%}
      
      <div class="card__content {% if is_first_article %} first-article{% endif %} {% if first_article_custom_enable %} color-{{ first_article_color_scheme }}{% endif %}"
        {% if first_article_custom_enable and first_article_content_id %}id="{{ first_article_content_id }}"{% endif %}
      >

				{% liquid
					assign items_amount = 1
					if show_comments or show_author
						assign items_amount = items_amount | plus: 1
					endif
					if show_description == 'show_all' or show_description == 'show_first' and is_first_article  
						if article.excerpt_or_content.size > 0
							assign items_amount = items_amount | plus: 1
						endif
					endif
					if read_more != blank or show_date
						assign items_amount = items_amount | plus: 1
					endif
				%}

        <div class="card__information card__information--{{ items_amount }}">
					{%- if show_comments or show_author -%}
						<div class="article-card__info caption-with-letter-spacing">
							{%- if show_comments -%}
								{%- if article.comments_count > 0 -%}
									<span class="article-card__comment">
										{{- 'blogs.article.comments' | t: count: article.comments_count -}}
									</span>
								{%- endif -%}
							{%- endif -%}

							{%- if show_author -%}
								<span>{{ article.author }}</span>
							{%- endif -%}
						</div>
					{%- endif -%}

					{%- if is_first_article -%}
						<p class="card__sub-heading clr-text-foreground-secondary">{{ 'blogs.article.featured' | t }} </p>
					{%- endif -%}


					<h3 class="card__heading {% if is_first_article %} h3 {% else %} h6 {{ settings.blog_card_text_weight }}{% endif %}">
						<a href="{{ article.url }}" class="full-unstyled-link"> {{ article.title | escape }}</a>
					</h3>

					{%- if show_description == 'show_all' or show_description == 'show_first' and is_first_article -%}
						{%- if article.excerpt_or_content.size > 0 -%}
							<p class="article-card__excerpt rte-width">
								{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
							</p>
						{%- endif -%}
					{%- endif -%}

					{%- if read_more != blank or show_date -%}
						<div class="article-card__footer">
							{% if read_more != blank %}
								<a class="link link-with-underline" href="{{ article.url }}">
									{{ read_more }}
								</a>
							{% endif %}

							{%- if show_date -%}
									<span class="article-card__date circle-divider">{{ article.published_at | date: '%-d %B' }}</span>
							{%- endif -%}
						</div>
					{%- endif -%}
        </div>

        <div class="card__badge {{ settings.badge_position }}">
          {%- if show_badge -%}
            <span class="badge color-{{ settings.color_schemes | first }} {{ settings.badge_text_weight }}">{{ 'blogs.article.blog' | t }}</span>
          {%- endif -%}

          {% for tag in article.tags %}
            <a
              href="{{ blog.url }}/tagged/{{ tag.handle }}"
              class="article-card__badge badge button--animate-{{ settings.animations_hover_elements }} {{ settings.badge_text_weight }}"
            >
							{{ tag }}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
