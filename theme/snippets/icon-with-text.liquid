{% comment %}
  Renders icon with text block

  Accepts:
  - block: {Object} passes in the block information.
	- class: {String} Add a class


  Usage:
  {% render 'icon-with-text',
    block: block
  %}
{% endcomment %}
{%- liquid
  assign heading_3_display = block.settings.heading_3

  if block.settings.enable_shipping_country_override
    case localization.country.iso_code
      when 'LT'
        assign heading_3_display = block.settings.heading_3_lt_override
    endcase
  endif

  assign heading_empty_1 = false
  assign heading_empty_2 = false
  assign heading_empty_3 = false
  assign text_only_all_items = true

  if block.settings.heading_1 == empty
    assign heading_empty_1 = true
  endif

  if block.settings.heading_2 == empty
    assign heading_empty_2 = true
  endif

  if heading_3_display == empty
    assign heading_empty_3 = true
  endif

  if heading_empty_1 == false and block.settings.icon_1 != 'none' or block.settings.image_1 != null
    assign text_only_all_items = false
  elsif heading_empty_2 == false and block.settings.icon_2 != 'none' or block.settings.image_2 != null
    assign text_only_all_items = false
  elsif heading_empty_3 == false and block.settings.icon_3 != 'none' or block.settings.image_3 != null
    assign text_only_all_items = false
  endif
-%}
<ul
  class="icon-with-text icon-with-text--{{ block.settings.layout }} list-unstyled{% if text_only_all_items %} icon-with-text--text-only{% endif %} {%- if class %} {{ class }} {% endif -%}"
  {{ block.shopify_attributes }}
>
  {%- unless heading_empty_1 -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_1 == null -%}
        {%- render 'icon-accordion', icon: block.settings.icon_1 -%}
      {%- else -%}
        <img
          src="{{ block.settings.image_1 | image_url }}"
          {% if block.settings.image_1.alt != blank %}
            alt="{{ block.settings.image_1.alt | escape }}"
          {% else %}
            role="presentation"
            alt="{{ block.settings.image_1.alt | escape }}"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      <span class="inline-richtext">
        {{- block.settings.heading_1 -}}
      </span>
    </li>
  {%- endunless -%}
  {%- unless heading_empty_2 -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_2 == null -%}
        {% render 'icon-accordion', icon: block.settings.icon_2 -%}
      {%- else -%}
        <img
          src="{{ block.settings.image_2 | image_url }}"
          {% if block.settings.image_2.alt != blank %}
            alt="{{ block.settings.image_2.alt | escape }}"
          {% else %}
            role="presentation"
            alt="{{ block.settings.image_2.alt | escape }}"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      <span class="inline-richtext">
        {{- block.settings.heading_2 -}}
      </span>
    </li>
  {%- endunless -%}
  {%- unless heading_empty_3 -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_3 == null -%}
        {% render 'icon-accordion', icon: block.settings.icon_3 -%}
      {%- else -%}
        <img
          src="{{ block.settings.image_3 | image_url }}"
          {% if block.settings.image_3.alt != blank %}
            alt="{{ block.settings.image_3.alt | escape }}"
          {% else %}
            role="presentation"
            alt="{{ block.settings.image_3.alt | escape }}"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      <span class="inline-richtext">
        {{- heading_3_display -}}
      </span>
    </li>
  {%- endunless -%}
</ul>
