{% comment %}
   Renders a fatured product card

   Accepts:
   - card_product: {Object} Product Liquid object (optional)
   - product_style: {String}
   - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
   - custom_image_height: {Number} Size of the product image height (optional)
   - image_shape: {String} Image mask to apply to the product image card. Values are "arch", "blob", "chevronleft", "chevronright", "diamond", "parallelogram", and "round". (optional)
   - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
   - show_vendor: {Boolean} Show the product vendor. Default: false
   - show_type: {Boolean} Show the product type. Default: true
   - show_rating: {Boolean} Show the product rating. Default: false
   - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
   - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
   - show_quick_add: {Boolean} Show the quick add button.
   - section_id: {String} The ID of the section that contains this card.
   - heading_size: {String} Product title size.
   - heading_weight: {String} Product title weight.
   - prise_size: {String} Product prise size.
   - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
   - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
   - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)
   - custom_color_scheme: {String} Custom color scheme to use
  - show_compare: {Boolean} Show compare button
  - show_color_variants: {Boolean} Show color variants. Visible if the feature is enabled in the theme settings.
  - columns: {Number} Number of columns in the grid. Default: 2

   Usage:
   {% render 'card-featured-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-rating.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ratio = 1
  if card_product.featured_media and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif card_product.featured_media and media_aspect_ratio == 'adapt'
    assign ratio = card_product.featured_media.aspect_ratio
  endif

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign ratio_percent = 1 | divided_by: ratio | times: 100
  if card_product.featured_media and media_aspect_ratio == 'custom'
    assign ratio_percent = custom_image_height
  endif

  assign color_scheme = settings.card_color_scheme

  if custom_color_scheme != blank
    assign color_scheme = custom_color_scheme
  endif

  if columns == blank or columns == 0
    assign columns = 2
  endif

  assign price_class = 'fw-400 '
  if price_size != blank
    assign price_class = price_class | append: price_size
  endif
-%}

{%- if card_product and card_product != empty -%}
  <div
    class="card-wrapper product-card-wrapper underline-links-hover  p-style-2 alignment-{{ settings.card_text_alignment }}"
    data-url="{{ card_product.url }}"
  >
    <div
      class="
        card card--product card--{{ settings.card_style }}
        {% if card_product.featured_media %} card--media{% else %} card--text{% endif %}
        {% if settings.card_style == 'card' %} color-{{ color_scheme }} gradient{% endif %}
        {% if image_shape and image_shape != 'default' %} card--shape{% endif %}
        {% if extend_height %} card--extend-height{% endif %}
        {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}
        {% if horizontal_class %} card--horizontal{% endif %}
      "
      style="--ratio-percent: {{ ratio_percent }}%;"
    >
      {% liquid
        assign num_options = card_product.options_with_values.size
        assign color_label_list = settings.product_variants_name | replace: ', ', ',' | downcase | split: ','
        assign has_color_option = false
        for color_label in color_label_list
          if card_product.options_by_name[color_label] != blank
            assign has_color_option = true
          endif
        endfor
        assign has_color_only = false
        if has_color_option and num_options == 1
          assign has_color_only = true
        endif
        assign allow_add_to_cart = false
        if card_product.variants.size <= 1
          assign allow_add_to_cart = true
        elsif has_color_only and show_color_variants
          assign allow_add_to_cart = true
        endif
      %}
      <div
        class="card__inner {% if settings.card_style == 'standard' %}color-{{ color_scheme }} gradient{% endif %}{% if card_product.featured_media or settings.card_style == 'standard' %} ratio{% endif %}"
        style="--ratio-percent: {{ ratio_percent }}%;"
      >
        {%- if card_product.featured_media -%}
          <div class="card__media">
            <swiper-slider
              id="Swiper-{{ section.id }}"
              class="swiper card-product__slider"
              data-slides-per-view="1"
              data-effect="fade"
            >
              <div class="swiper-wrapper">
                {%- for media in card_product.media -%}
                  <div
                    id="Slide-{{ section.id }}-{{ media.id }}"
                    class="swiper-slide"
                    data-media-id="{{ section.id }}-{{ media.id }}"
                  >
                    <div class="media media--transparent media--hover-effect">
                      <img
                        srcset="
                          {%- if media.width >= 165 -%}{{ media | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if media.width >= 360 -%}{{ media | image_url: width: 360 }} 360w,{%- endif -%}
                          {%- if media.width >= 533 -%}{{ media | image_url: width: 533 }} 533w,{%- endif -%}
                          {%- if media.width >= 720 -%}{{ media | image_url: width: 720 }} 720w,{%- endif -%}
                          {%- if media.width >= 940 -%}{{ media | image_url: width: 940 }} 940w,{%- endif -%}
                          {%- if media.width >= 1066 -%}{{ media | image_url: width: 1066 }} 1066w,{%- endif -%}
                          {{ media | image_url }} {{ media.width }}w
                        "
                        src="{{ media | image_url: width: 533 }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: columns }}px, (min-width: 990px) calc((100vw - 130px) / {{ columns }}), (min-width: 750px) calc((100vw - 120px) / {{ columns }}), calc((100vw - 35px) / 2)"
                        alt="{{ media.alt | escape }}"
                        class="motion-reduce"
                        {% unless lazy_load == false %}
                          loading="lazy"
                        {% endunless %}
                        width="{{ media.width }}"
                        height="{{ media.height }}"
                      >
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </swiper-slider>
          </div>
        {%- else -%}
          <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ color_scheme }} gradient{% endif %}">
            <div class="media media--transparent media--hover-effect">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
          </div>
        {%- endif -%}

        <div class="card__content">
          <div class="card__information">
            <h3
              class="card__heading {{ settings.card_heading_font_family }}"
              {% if card_product.featured_media == null and settings.card_style == 'standard' %}
                id="title-{{ section_id }}-{{ card_product.id }}"
              {% endif %}
            >
              <a
                href="{{ card_product.url }}"
                id="StandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}"
                class="full-unstyled-link"
                aria-labelledby="StandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }} NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
              >
                {{ card_product.title | escape }}
              </a>
            </h3>
          </div>
          <div class="card__badge {{ settings.badge_position }} {{ settings.badge_text_weight }}">
            {% for tag in card_product.tags %}
              {%- liquid
                assign tag_handleize = tag | handleize
                assign badge_names = settings.badge_names | split: ','
              %}
              {% for badge in badge_names %}
                {% assign badge_handleize = badge | handleize %}
                {% if tag_handleize contains badge_handleize and tag_handleize == badge_handleize %}
                  <span
                    class="badge color-{{ settings.sale_badge_color_scheme }}"
                    aria-hidden="true"
                  >
                    {{- badge | escape -}}
                  </span>
                {% endif %}
              {% endfor %}
            {% endfor %}
            {%- if card_product.available == false -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
              >
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
              >
                {{- 'products.product.on_sale' | t -}}
              </span>
            {%- endif -%}
          </div>
          {%- if show_compare -%}
            <compare-button class="product-compare {{ settings.badge_position }} {{ settings.badge_text_weight }}" tabindex="0">
              {% assign product_url = card_product.url %}
              <input
                class="product-compare-checkbox"
                type="checkbox"
                id="compare-checkbox-{{ section.id }}-{{ card_product.id }}{{ menu_id }}"
                data-product-id="{{ card_product.id }}"
                data-product-url="{{ product_url }}"
              >
              <label
                class="product-compare-info"
                for="compare-checkbox-{{ section.id }}-{{ card_product.id }}{{ menu_id }}"
              >
                <span class="product-compare-text">
                  {{ 'products.product.compare' | t }}
                </span>
                <div class="product-compare-icon">
                  {% render 'icon-compare' %}
                </div>
              </label>
            </compare-button>
          {%- endif -%}

          <div class="card__wrapper hidden">
            {%- if show_quick_add and allow_add_to_cart == false -%}
              <div class="quick-add no-js-hidden">
                {%- liquid
                  assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
                  assign qty_rules = false
                  if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                    assign qty_rules = true
                  endif
                -%}
                {%- if card_product.variants.size > 1 or qty_rules -%}
                  <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                    <button
                      id="{{ product_form_id }}-submit"
                      type="submit"
                      name="add"
                      class="quick-add__submit button button--full-width button--{{ settings.quick_add_button_style }} button--{{ settings.quick_add_button_outline }} {% if horizontal_quick_add %} card--horizontal__quick-add animate-arrow{% endif %} button--animate-{{ settings.animations_hover_elements }}"
                      aria-haspopup="dialog"
                      aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                      data-product-url="{{ card_product.url }}"
											data-initial-product-id="{{ card_product.id }}"
                    >
											{{ 'products.product.choose_options' | t }}
											{%- if horizontal_quick_add -%}
												<span class="icon-wrap">{% render 'icon-arrow' %}</span>
											{%- endif -%}
                      {%- render 'loading-spinner' -%}
                    </button>
                  </modal-opener>
                  <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                    <popup-overlay class="popup-overlay"></popup-overlay>
                    <div
                      role="dialog"
                      aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                      aria-modal="true"
                      class="quick-add-modal__content global-settings-popup"
                      tabindex="-1"
                    >
                      <button
                        class="drawer__close button--animate-{{ settings.animations_hover_elements }}"
                        type="button"
                        id="ModalClose-{{ card_product.id }}"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
												{% render 'icon-close' %}
                      </button>

                      <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                    </div>
                  </quick-add-modal>
                {%- endif -%}
              </div>
            {%- endif -%}
            {% if allow_add_to_cart %}
            <product-form class="product-form" data-section-id="{{ section.id }}">
              {%- form 'product',
                card_product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ card_product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
                >
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--{{ settings.card_button_style }} button--{{ settings.card_button_outline }} {% if horizontal_quick_add %} card--horizontal__quick-add{% endif %} button--animate-{{ settings.animations_hover_elements }}"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% if card_product.selected_or_first_available_variant.available == false %}
                    disabled
                  {% endif %}
									data-initial-product-id="{{ card_product.id }}"
                >
									<span>
										{%- if card_product.selected_or_first_available_variant.available -%}
											{{ 'products.product.add_to_cart' | t }}
										{%- else -%}
											{{ 'products.product.sold_out' | t }}
										{%- endif -%}
									</span>
                  <span class="sold-out-message hidden">
                    {{ 'products.product.sold_out' | t }}
                  </span>
                  {%- if horizontal_quick_add -%}
                    <span class="icon-wrap">{% render 'icon-plus' %}</span>
                  {%- endif -%}
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
            {% else %}
              <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}" class="product-variant-id">
            {% endif %}

            {% if show_color_variants %}
              {%- assign color_label_list = settings.product_variants_name
                | replace: ', ', ','
                | downcase
                | split: ','
              -%}
              {%- for color_label in color_label_list -%}
                {%- if card_product.options_by_name[color_label] != blank -%}
                  {%- assign product_option = card_product.options_by_name[color_label] -%}
                  <div class="card-variants-wrapp no-js-hidden" data-test="{{ color_label }}">
                    <card-variants class="card-variants" data-product-style="{{ product_style }}">
                      {%- assign variant_option = 'option' | append: product_option.position -%}

                      {%- capture color_name -%}{{ section.id }}-{{ block.id }}-{{ card_product.id }}{%- endcapture -%}

                      {%- for value in product_option.values -%}
                        {%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
                        {%- assign variant_for_value = card_product.variants | where: variant_option, value | first -%}

                        <div
                          class="card-variant {% if variant_for_value.available == false %} card-variant--disabled{% endif %}"
                          data-variant-id="{{ variant_for_value.id }}"
                          {% if variant_for_value.featured_media != blank %}
                            data-variant-img="{{ variant_for_value.featured_media | image_url: width: 533 }}"
                          {% endif %}
                          data-variant-price="{% if settings.currency_code_enabled %}{{ variant_for_value.price | money_with_currency }}{% else %}{{ variant_for_value.price | money }}{% endif %}"
                          data-variant-price-value="{{ variant_for_value.price }}"
                          {% if variant_for_value.compare_at_price %}
                            data-variant-compare-at-price="{% if settings.currency_code_enabled %}{{ variant_for_value.compare_at_price | money_with_currency }}{% else %}{{ variant_for_value.compare_at_price | money }}{% endif %}"
                            data-variant-compare-at-price-value="{{ variant_for_value.compare_at_price }}"
                          {% endif %}
                          role="button"
                          aria-label="Card variant"
                          tabindex="0"
                        >
                          <input
                            class="card-variant__radio visually-hidden"
                            type="radio"
                            name="{{ color_name }}"
                            id="{{ color_id }}"
                            value="{{ value | escape }}"
                            {% if product_option.selected_value == value %}
                              checked="checked"
                            {% endif %}
                          >

                          <label class="card-variant__item dropdown-swatch" for="{{ color_id }}">
                            <span class="visually-hidden">{{ value }}</span>
                            {% render 'swatch', swatch: value.swatch %}
                          </label>
                        </div>
                      {%- endfor -%}
                    </card-variants>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {% endif %}
          </div>

          <a
            href="{{ card_product.url }}"
            class="content-link"
            aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}"
          >
          </a>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information">
					<div>
						{%- if show_type and card_product.type != blank-%}
							<div class="card__product-subheading">{{ card_product.type }}</div>
						{%- endif -%}
						<h3
							class="card__heading {{ settings.card_heading_font_family }} {{ heading_size }} {{ heading_weight }}"
							{% if card_product.featured_media or settings.card_style == 'card' %}
								id="title-{{ section_id }}-{{ card_product.id }}"
							{% endif %}
						>
							<a
								href="{{ card_product.url }}"
								id="CardLink-{{ section_id }}-{{ card_product.id }}"
								class="full-unstyled-link"
								aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}"
							>
								{{ card_product.title | escape }}
							</a>
						</h3>
						<div class="card-information">
							{%- if show_vendor -%}
								<span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
								<div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
							{%- endif -%}

							<span class="caption-large light">{{ block.settings.description | escape }}</span>

							{%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
								{% liquid
									assign rating_decimal = 0
									assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
									if decimal >= 0.3 and decimal <= 0.7
										assign rating_decimal = 0.5
									elsif decimal > 0.7
										assign rating_decimal = 1
									endif
								%}
								<div
									class="rating"
									role="img"
									aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
								>
									<span
										aria-hidden="true"
										class="rating-star"
										style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
									></span>
								</div>
								<p class="rating-text caption">
									<span aria-hidden="true">
										{{- card_product.metafields.reviews.rating.value }} /
										{{ card_product.metafields.reviews.rating.value.scale_max -}}
									</span>
								</p>
								<p class="rating-count caption">
									<span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
									<span class="visually-hidden">
										{{- card_product.metafields.reviews.rating_count }}
										{{ 'accessibility.total_reviews' | t -}}
									</span>
								</p>
							{%- endif -%}

							<div class="card__product-container">
								{% render 'price', product: card_product, price_class: price_class, show_compare_at_price: true %}
							</div>


							{%- if card_product.quantity_price_breaks_configured? -%}
								<div class="card__information-volume-pricing-note">
									<span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
								</div>
							{%- endif -%}

							{% if show_color_variants %}
								{%- assign color_label_list = settings.product_variants_name
									| replace: ', ', ','
									| downcase
									| split: ','
								-%}
								{%- for color_label in color_label_list -%}
									{%- if card_product.options_by_name[color_label] != blank -%}
										{%- assign product_option = card_product.options_by_name[color_label] -%}
										<div class="card-variants-wrapp no-js-hidden" data-test="{{ color_label }}">
											<card-variants class="card-variants" data-product-style="{{ product_style }}">
												{%- assign variant_option = 'option' | append: product_option.position -%}

												{%- capture color_name -%}{{ section.id }}-{{ block.id }}-{{ card_product.id }}{%- endcapture -%}

												{%- for value in product_option.values -%}
													{%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
													{%- assign variant_for_value = card_product.variants | where: variant_option, value | first -%}

												<div
													class="card-variant {% if variant_for_value.available == false %} card-variant--disabled{% endif %}"
													data-variant-id="{{ variant_for_value.id }}"
													{% if variant_for_value.featured_media != blank %}
														data-variant-img="{{ variant_for_value.featured_media | image_url: width: 533 }}"
													{% endif %}
													data-variant-price="{% if settings.currency_code_enabled %}{{ variant_for_value.price | money_with_currency }}{% else %}{{ variant_for_value.price | money }}{% endif %}"
													data-variant-price-value="{{ variant_for_value.price }}"
													{% if variant_for_value.compare_at_price %}
														data-variant-compare-at-price="{% if settings.currency_code_enabled %}{{ variant_for_value.compare_at_price | money_with_currency }}{% else %}{{ variant_for_value.compare_at_price | money }}{% endif %}"
														data-variant-compare-at-price-value="{{ variant_for_value.compare_at_price }}"
													{% endif %}
													role="button"
													aria-label="Card variant"
													tabindex="0"
												>
													<input
														class="card-variant__radio visually-hidden"
														type="radio"
														name="{{ color_name }}"
														id="{{ color_id }}"
														value="{{ value | escape }}"
														{% if product_option.selected_value == value %}
															checked="checked"
														{% endif %}
													>

													<label
														class="card-variant__item dropdown-swatch color--{{ value | escape | downcase | replace: " ", "-" }}"
														for="{{ color_id }}"
													>
														<span class="visually-hidden">{{ value }}</span>

														{% render 'swatch', swatch: value.swatch %}
													</label>
												</div>
											{%- endfor -%}
										</card-variants>
									</div>
								{%- endif -%}
							{%- endfor -%}
						{% endif %}
					</div>
				</div>
				<a
						href="{{ card_product.url }}"
						class="card-featured-product__link"
						aria-label="{{ card_product.title | escape }}"
					></a>
        </div>
        <div class="card__badge {{ settings.badge_position }} {{ settings.badge_text_weight }}">
          {% for tag in card_product.tags %}
            {%- liquid
              assign tag_handleize = tag | handleize
              assign badge_names = settings.badge_names | split: ','
            %}
            {% for badge in badge_names %}
              {% assign badge_handleize = badge | handleize %}
              {% if tag_handleize contains badge_handleize and tag_handleize == badge_handleize %}
                <span
                  class="badge color-{{ settings.sale_badge_color_scheme }}"
                  aria-hidden="true"
                >
                  {{- badge | escape -}}
                </span>
              {% endif %}
            {% endfor %}
          {% endfor %}
          {%- if card_product.available == false -%}
            <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
            >
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
            <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
            >
              {{- 'products.product.on_sale' | t -}}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign ratio = 1
    if media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    endif
  -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover p-style-2 {% if settings.card_style == 'card' %} color-{{ color_scheme }} gradient{% endif %}">
    <div
      class="
        card card--{{ settings.card_style }} card-product--placeholder
        {% if extend_height %} card--extend-height{% endif %}
        {% if image_shape and image_shape != 'default' %} card--shape{% endif %} 
      "
      style="--ratio-percent: {{ ratio_percent }}%;"
    >
      <div
        class="card__inner{% if settings.card_style == 'standard' %} color-{{ color_scheme }} gradient{% endif %} ratio"
      >
        <div
          class="card__media {% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ color_scheme }} gradient{% endif %}"
        >
          <div
            class="media media--transparent"
          >
            {%- if placeholder_image -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading card__heading--placeholder {{ heading_size }} {{ heading_weight }}">
              <a role="link" aria-disabled="true" class="full-unstyled-link">
                {{ 'onboarding.product_title' | t }}
              </a>
            </h3>
            <div class="card-information">
							<div>
								{%- if show_vendor -%}
									<span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
									<div class="caption-with-letter-spacing light card__vendor">{{ 'products.product.vendor' | t }}</div>
								{%- endif -%}

								<div class="card__price-container">
									{% render 'price', price_class: price_class, color: 'foreground-secondary', show_compare_at_price: true %}
								</div>
									

								{% if show_color_variants %}
									{%- assign color_label_list = settings.product_variants_name
										| replace: ', ', ','
										| downcase
										| split: ','
									-%}
									{%- for color_label in color_label_list -%}
										{%- if card_product.options_by_name[color_label] != blank -%}
											{%- assign product_option = card_product.options_by_name[color_label] -%}
											<div class="card-variants-wrapp no-js-hidden" data-test="{{ color_label }}">
												<card-variants class="card-variants" data-product-style="{{ product_style }}">
													{%- assign variant_option = 'option' | append: product_option.position -%}

													{%- capture color_name -%}{{ section.id }}-{{ block.id }}-{{ card_product.id }}{%- endcapture -%}

													{%- for value in product_option.values -%}
														{%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
														{%- assign variant_for_value = card_product.variants
															| where: variant_option, value
															| first
														-%}

													<div
														class="card-variant {% if variant_for_value.available == false %} card-variant--disabled{% endif %}"
														data-variant-id="{{ variant_for_value.id }}"
														{% if variant_for_value.featured_media != blank %}
															data-variant-img="{{ variant_for_value.featured_media | image_url: width: 533 }}"
														{% endif %}
														data-variant-price="{% if settings.currency_code_enabled %}{{ variant_for_value.price | money_with_currency }}{% else %}{{ variant_for_value.price | money }}{% endif %}"
														data-variant-price-value="{{ variant_for_value.price }}"
														{% if variant_for_value.compare_at_price %}
															data-variant-compare-at-price="{% if settings.currency_code_enabled %}{{ variant_for_value.compare_at_price | money_with_currency }}{% else %}{{ variant_for_value.compare_at_price | money }}{% endif %}"
															data-variant-compare-at-price-value="{{ variant_for_value.compare_at_price }}"
														{% endif %}
														role="button"
														aria-label="Card variant"
														tabindex="0"
													>
														<input
															class="card-variant__radio visually-hidden"
															type="radio"
															name="{{ color_name }}"
															id="{{ color_id }}"
															value="{{ value | escape }}"
															{% if product_option.selected_value == value %}
																checked="checked"
															{% endif %}
														>

														<label
															class="card-variant__item dropdown-swatch color--{{ value | escape | downcase | replace: " ", "-" }}"
															for="{{ color_id }}"
														>
															<span class="visually-hidden">{{ value }}</span>

															{% render 'swatch', swatch: value.swatch %}
														</label>
													</div>
												{%- endfor -%}
											</card-variants>
										</div>
									{%- endif -%}
								{%- endfor -%}
							{% endif %}
						</div>
            </div>
          </div>
        </div>
      </div>
    </div>
		<div class="card__content">
			<div class="card__information">
				{%- if show_type and card_product.type != blank-%}
					<div class="card__product-subheading">{{ card_product.type }}</div>
				{%- endif -%}
				<h3 class="card__heading card__heading--placeholder {{ heading_size }} {{ heading_weight }}">
					<a role="link" aria-disabled="true" class="full-unstyled-link">
						{{ 'onboarding.product_title' | t }}
					</a>
				</h3>
				<div class="card-information">
					{%- if show_vendor -%}
						<span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
						<div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
					{%- endif -%}
					
					<div class="card__product-container">
						{% render 'price', price_class: price_class, color: 'foreground-secondary', show_compare_at_price: true %}
					</div>

					{% if show_color_variants %}
						{%- assign color_label_list = settings.product_variants_name
							| replace: ', ', ','
							| downcase
							| split: ','
						-%}
						{%- for color_label in color_label_list -%}
							{%- if card_product.options_by_name[color_label] != blank -%}
								{%- assign product_option = card_product.options_by_name[color_label] -%}
								<div class="card-variants-wrapp no-js-hidden" data-test="{{ color_label }}">
									<card-variants class="card-variants">
										{%- assign variant_option = 'option' | append: product_option.position -%}

										{%- capture color_name -%}{{ section.id }}-{{ block.id }}-{{ card_product.id }}{%- endcapture -%}

										{%- for value in product_option.values -%}
											{%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
											{%- assign variant_for_value = card_product.variants | where: variant_option, value | first -%}

											<div class="card-variant {% if variant_for_value.available == false %} card-variant--disabled{% endif %}" data-variant-id="{{ variant_for_value.id }}" {% if variant_for_value.featured_media != blank %} data-variant-img="{{ variant_for_value.featured_media | image_url: width: 533 }}"{% endif %} data-variant-price="{% if settings.currency_code_enabled %}{{ variant_for_value.price | money_with_currency }}{% else %}{{ variant_for_value.price | money }}{% endif %}" data-variant-price-value="{{ variant_for_value.price }}" {% if variant_for_value.compare_at_price %}data-variant-compare-at-price="{% if settings.currency_code_enabled %}{{ variant_for_value.compare_at_price | money_with_currency }}{% else %}{{ variant_for_value.compare_at_price | money }}{% endif %}" data-variant-compare-at-price-value="{{ variant_for_value.compare_at_price }}"{% endif %} role="button" aria-label="Card variant" tabindex="0">
												<input class="card-variant__radio visually-hidden" type="radio" name="{{ color_name }}" id="{{ color_id }}" value="{{ value | escape }}" {% if product_option.selected_value == value %}checked="checked"{% endif %}>

												<label
													class="card-variant__item dropdown-swatch"
													for="{{ color_id }}"
												>
													<span class="visually-hidden">{{ value }}</span>

													{% render 'swatch', swatch: value.swatch %}
												</label>
											</div>
										{%- endfor -%}
									</card-variants>
								</div>
							{%- endif -%}
						{%- endfor -%}
					{% endif %}
				</div>
			</div>
		</div>
  </div>
{%- endif -%}
