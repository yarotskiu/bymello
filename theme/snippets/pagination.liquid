{% comment %}
  Renders a set of links for paginated results. Must be used within paginate tags.

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID', button_style: 'secondary' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
  - button_style: {String} (optional) Button style for pagination. Values: 'general', 'secondary'. Default: 'general'
{% endcomment %}

{{ 'component-pagination.css' | asset_url | stylesheet_tag }}

{%- if paginate.parts.size > 0 -%}
<div class="pagination-wrapper{% if button_style == 'secondary' %} secondary-button-style{% endif %}">
	<nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
		<ul class="pagination__list list-unstyled{% if paginate.parts.size > 4 %} space-between{% endif %} {{ font_weight }}" role="list">
			{%- if paginate.next.title != blank or paginate.previous.title != blank -%}
			<li>
				<a href="{{ paginate.previous.url }}{{ anchor }}"
					class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce active {% if paginate.previous.title == blank %} disabled {% endif %} button--animate-{{ settings.animations_hover_elements }}"
					aria-label="{{ 'general.pagination.previous' | t }}">
					{% render 'icon-short-arrow' %}
				</a>
			</li>
			{%- endif -%}

			{%- for part in paginate.parts -%}
			<li>
				{%- if part.is_link -%}
				<a href="{{ part.url }}{{ anchor }}" class="pagination__item pagination__item--link link"
					aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
					<span class="link-underline">
						{{- part.title -}}
					</span>
				</a>
				{%- else -%}
				{%- if part.title == paginate.current_page -%}
				<a role="link" aria-disabled="true" class="pagination__item pagination__item--link link pagination__item--current light"
					aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
					<span class="link-underline">
						{{- part.title -}}
					</span>
				</a>
				{%- else -%}
				<span class="pagination__item">{{ part.title }}</span>
				{%- endif -%}
				{%- endif -%}
			</li>
			{%- endfor -%}

			{%- if paginate.next.title != blank or paginate.previous.title != blank -%}
			<li>
				<a href="{{ paginate.next.url }}{{ anchor }}"
					class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce active {% if paginate.next.title == blank %} disabled {% endif %} button--animate-{{ settings.animations_hover_elements }}"
					aria-label="{{ 'general.pagination.next' | t }}">
					{% render 'icon-short-arrow' %}
				</a>
			</li>
			{%- endif -%}
		</ul>
	</nav>
</div>
{%- endif -%}